{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "cd astro-site && npm ci",
  "buildCommand": "cd astro-site && npm run build",
  "outputDirectory": "astro-site/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "misstravel.me"
        }
      ],
      "destination": "https://www.misstravel.me/:path*",
      "permanent": true
    },
    {"source": "/announcements/2022-10-09-website.html", "destination": "/announcements/website/", "permanent": true},
    {"source": "/announcements/2022-10-09-website/", "destination": "/announcements/website/", "permanent": true},
    {"source": "/infos/2022-10-06-account/", "destination": "/infos/account/", "permanent": true},
    {"source": "/infos/2022-10-06-guide.html", "destination": "/infos/guide/", "permanent": true},
    {"source": "/infos/2022-10-06-guide/", "destination": "/infos/guide/", "permanent": true},
    {"source": "/infos/2022-10-06-map.html", "destination": "/infos/map/", "permanent": true},
    {"source": "/infos/2022-10-06-map/", "destination": "/infos/map/", "permanent": true},
    {"source": "/infos/2022-10-06-menu/", "destination": "/infos/menu/", "permanent": true},
    {"source": "/infos/2022-10-06-roles/", "destination": "/infos/roles/", "permanent": true},
    {"source": "/infos/2022-10-06-set-menu-info/", "destination": "/infos/set-menu-info/", "permanent": true},
    {"source": "/infos/2022-10-07-video.html", "destination": "/infos/video/", "permanent": true},
    {"source": "/infos/2022-10-07-video/", "destination": "/infos/video/", "permanent": true},
    {"source": "/infos/2022-10-08-contact-method.html", "destination": "/infos/contact-method/", "permanent": true},
    {"source": "/infos/2022-10-08-contact-method/", "destination": "/infos/contact-method/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_1.html", "destination": "/rooms/campsite_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_1/", "destination": "/rooms/campsite_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_2.html", "destination": "/rooms/campsite_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_2/", "destination": "/rooms/campsite_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_3.html", "destination": "/rooms/campsite_3/", "permanent": true},
    {"source": "/rooms/2022-10-07-campsite_3/", "destination": "/rooms/campsite_3/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_1.html", "destination": "/rooms/log_cabin_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_1/", "destination": "/rooms/log_cabin_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_2.html", "destination": "/rooms/log_cabin_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_2/", "destination": "/rooms/log_cabin_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_3.html", "destination": "/rooms/log_cabin_3/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_3/", "destination": "/rooms/log_cabin_3/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_4.html", "destination": "/rooms/log_cabin_4/", "permanent": true},
    {"source": "/rooms/2022-10-07-log_cabin_4/", "destination": "/rooms/log_cabin_4/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_1.html", "destination": "/rooms/suite_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_1/", "destination": "/rooms/suite_1/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_2.html", "destination": "/rooms/suite_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_2/", "destination": "/rooms/suite_2/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_3.html", "destination": "/rooms/suite_3/", "permanent": true},
    {"source": "/rooms/2022-10-07-suite_3/", "destination": "/rooms/suite_3/", "permanent": true},
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/rooms.html", "destination": "/rooms/", "permanent": true },
    { "source": "/infos.html", "destination": "/infos/", "permanent": true },
    { "source": "/galleries.html", "destination": "/galleries/", "permanent": true },
    { "source": "/sale_items.html", "destination": "/sale_items/", "permanent": true },
    { "source": "/announcements.html", "destination": "/announcements/", "permanent": true },
    { "source": "/infos/2022-10-06-roles.html", "destination": "/infos/roles/", "permanent": true },
    { "source": "/infos/2022-10-06-account.html", "destination": "/infos/account/", "permanent": true },
    { "source": "/infos/2022-10-06-set-menu-info.html", "destination": "/infos/set-menu-info/", "permanent": true },
    { "source": "/infos/2022-10-06-menu.html", "destination": "/infos/menu/", "permanent": true },
    { "source": "/rooms/:slug.html", "destination": "/rooms/:slug/", "permanent": true },
    { "source": "/infos/:slug.html", "destination": "/infos/:slug/", "permanent": true },
    { "source": "/announcements/:slug.html", "destination": "/announcements/:slug/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/generated-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://img.youtube.com data:; frame-src https://www.youtube.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "trailingSlash": true
}
