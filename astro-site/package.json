{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit",
    "verify": "npm audit --audit-level=high && npm run typecheck && vitest run",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "js-yaml": "5.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
