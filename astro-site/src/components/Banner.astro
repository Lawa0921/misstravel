---
import { siteConfig } from '../lib/config';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = '密式旅行', subtitle = '秘密景點，深度旅行' } = Astro.props;
---

<section id="banner" class="major">
  <div class="inner">
    <header class="major">
      <h1>{title} / MissTravel</h1>
    </header>
    <div class="content">
      <p>{subtitle}</p>
      <ul class="actions">
        <li>
          <a href="/rooms/" class="button special">查看房型</a>
        </li>
        <li>
          <a
            href={siteConfig.booking.url}
            class="button"
            target="_blank"
            rel="noopener noreferrer"
          >
            立即預訂
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  #banner {
    position: relative;
    display: flex;
    align-items: center;
    height: 75vh;
    min-height: 30em;
    max-height: 50em;
    padding: 4em 0 2em;
    background-image: url('/images/banner.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    margin-bottom: -3.25em;
    top: -3.25em;
  }

  #banner::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #242943;
    opacity: 0.85;
    z-index: 1;
  }

  .inner {
    position: relative;
    z-index: 2;
    padding: 0 3em;
    max-width: 65em;
    width: 100%;
  }

  header.major h1 {
    font-size: 3.25em;
    margin: 0;
    padding-bottom: 0.35em;
    border-bottom: none;
  }

  header.major::after {
    content: '';
    display: block;
    border-bottom: solid 2px #fff;
    margin-top: 0.5em;
    width: 100%;
  }

  .content {
    display: flex;
    align-items: center;
    margin-top: 2em;
  }

  .content p {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin: 0;
    margin-right: 1.5em;
  }

  .actions {
    display: flex;
    gap: 0.5em;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .button {
    display: inline-block;
    padding: 0.75em 2em;
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    border: solid 2px #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .button:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .button.special {
    background: #fff;
    color: #242943;
    border-color: #fff;
  }

  .button.special:hover {
    background: #9bf1ff;
    border-color: #9bf1ff;
  }

  @media (max-width: 1280px) {
    #banner {
      background-attachment: scroll;
    }
  }

  @media (max-width: 736px) {
    #banner {
      height: auto;
      min-height: 0;
      max-height: none;
      padding: 6em 0 2em;
      margin-bottom: -2.75em;
      top: -2.75em;
    }

    .inner {
      padding: 0 1.5em;
    }

    header.major h1 {
      font-size: 2em;
    }

    .content {
      display: block;
    }

    .content p {
      margin-bottom: 1.5em;
      margin-right: 0;
    }

    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
      text-align: center;
    }
  }
</style>
