---
import { siteConfig } from '../lib/config';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = '密式旅行', subtitle = '秘密景點，深度旅行' } = Astro.props;
---

<section id="banner" class="major" data-motion-scene="">
  <div class="inner">
    <header class="major">
      <h1>{title} / MissTravel</h1>
    </header>
    <div class="content">
      <p>{subtitle}</p>
      <ul class="actions">
        <li>
          <a href="/rooms/" class="button special">查看房型</a>
        </li>
        <li>
          <a
            href={siteConfig.booking.url}
            class="button"
            target="_blank"
            rel="noopener noreferrer"
          >
            查詢空房
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  #banner {
    position: relative;
    display: flex;
    align-items: center;
    height: 75vh;
    min-height: 30em;
    max-height: 50em;
    padding: 4em 0 2em;
    margin-bottom: -3.25em;
    top: -3.25em;
    overflow: hidden;
  }

  #banner::before {
    content: '';
    position: absolute;
    inset: -3%;
    background-image: url('/images/banner.webp');
    background-size: cover;
    background-position: center;
    transform: translate3d(var(--scene-x), var(--scene-y), 0) scale(1.06);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at var(--scene-pointer-x) var(--scene-pointer-y),
        rgba(111, 195, 223, 0.22),
        transparent 32%
      ),
      linear-gradient(115deg, rgba(18, 26, 45, 0.76), rgba(36, 41, 67, 0.9) 55%, rgba(35, 57, 51, 0.78));
    z-index: 1;
    transition: background 0.25s ease;
  }

  .inner {
    position: relative;
    z-index: 2;
    padding: 0 3em;
    max-width: 65em;
    width: 100%;
    animation: banner-arrive 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes banner-arrive {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  header.major h1 {
    font-size: 3.25em;
    margin: 0;
    padding-bottom: 0.35em;
    border-bottom: none;
  }

  header.major::after {
    content: '';
    display: block;
    border-bottom: solid 2px #fff;
    margin-top: 0.5em;
    width: 100%;
  }

  .content {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2em;
  }

  .content > p {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 0.5em;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .button {
    display: inline-block;
    padding: 0.75em 2em;
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    border: solid 2px #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .button:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .button.special {
    background: #fff;
    color: #242943;
    border-color: #fff;
  }

  .button.special:hover {
    background: #9bf1ff;
    border-color: #9bf1ff;
  }

  @media (max-width: 736px) {
    #banner {
      height: auto;
      min-height: 0;
      max-height: none;
      padding: 6em 0 2em;
      margin-bottom: -2.75em;
      top: -2.75em;
    }

    .inner {
      padding: 0 1.5em;
    }

    header.major h1 {
      font-size: 2em;
    }

    .content {
      display: block;
    }

    .content > p {
      margin-bottom: 1.5em;
      font-size: 1.25rem;
    }

    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #banner::before,
    .inner {
      animation: none;
      transform: none;
    }
  }
</style>
