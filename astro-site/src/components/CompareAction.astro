---
interface Props { id: string; title: string; shortTitle: string; }
const { id, title, shortTitle } = Astro.props;
---
<button type="button" class="compare-toggle" data-compare-toggle={id} aria-pressed="false" aria-label={`比較${shortTitle}`} title={title} hidden>
  <svg data-compare-decoration="check" class="compare-toggle-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path class="compare-plus" d="M10 4v12M4 10h12"/><path class="compare-check" d="m4 10 4 4 8-8"/></svg>
  <span data-compare-label>加入比較</span>
</button>
<style>
  .compare-toggle[hidden] { display:none!important; }
  .compare-toggle { display:inline-flex;align-items:center;justify-content:center;gap:.5rem;margin:.5rem .25rem 0;align-self:flex-end;min-height:44px;padding:.4rem .8rem;border:1px solid var(--color-border);border-radius:999px;background:transparent;color:var(--color-paper-muted);font:inherit;font-size:.8rem;cursor:pointer;transition:background 160ms,color 160ms; }
  .compare-toggle[aria-pressed="true"] { color:var(--color-aqua);border-color:var(--color-aqua);background:rgba(157,216,208,.1); }
  .compare-toggle:hover { border-color:var(--color-aqua);color:var(--color-aqua); }
  .compare-toggle:focus-visible { outline:2px solid var(--color-aqua);outline-offset:4px; }
  .compare-toggle-icon { flex:none; }
  .compare-check,.compare-toggle[aria-pressed="true"] .compare-plus { display:none; }
  .compare-toggle[aria-pressed="true"] .compare-check { display:initial; }
  @media(prefers-reduced-motion:reduce){.compare-toggle{transition:none;}}
</style>
