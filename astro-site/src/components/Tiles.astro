---
import { siteConfig } from '../lib/config';

interface TileItem {
  href: string;
  title: string;
  description: string;
  image: string;
  external?: boolean;
}

interface Props {
  items?: TileItem[];
}

const defaultTiles: TileItem[] = [
  {
    href: '/rooms/',
    title: '住宿房型',
    description: '露營、小木屋、套房',
    image: '/images/rooms.webp',
  },
  {
    href: '/infos/',
    title: '園區資訊',
    description: '規約、地圖、菜單',
    image: '/images/landing_banner.webp',
  },
  {
    href: '/galleries/',
    title: '園區相簿',
    description: '美景、設施、活動',
    image: '/images/galleries.webp',
  },
  {
    href: '/announcements/',
    title: '最新消息',
    description: '公告與活動',
    image: '/images/announcements.webp',
  },
  {
    href: '/infos/guide/',
    title: '遊玩指南',
    description: '周邊景點推薦',
    image: '/images/guide/guide_1_1.webp',
  },
  {
    href: siteConfig.booking.url,
    title: '空房查詢',
    description: '密式旅行，介於山巒的懷抱',
    image: '/images/booking.webp',
    external: true,
  },
];

const { items = defaultTiles } = Astro.props;
const displayItems = items.slice(0, siteConfig.tilesCount);
---

<section id="tiles" class="tiles">
  {displayItems.map((tile, index) => (
    <article class="tile" style={`animation-delay: ${index * 0.1}s`}>
      <span class="image">
        <img
          src={tile.image}
          alt={`${tile.title} - 密式旅行住宿選擇`}
          loading="lazy"
          decoding="async"
        />
      </span>
      <header class="major">
        <h3>
          <a
            href={tile.href}
            class="link"
            target={tile.external ? '_blank' : undefined}
            rel={tile.external ? 'noopener noreferrer' : undefined}
          >
            {tile.title}
          </a>
        </h3>
        <p>{tile.description}</p>
      </header>
    </article>
  ))}
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .tile {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tile .image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .tile .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.3s ease;
  }

  .tile:hover .image img {
    transform: scale(1.1);
    filter: brightness(0.7);
  }

  .tile .major {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    background: linear-gradient(to top, rgba(36, 41, 67, 0.9) 0%, transparent 100%);
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
  }

  .tile:hover .major {
    transform: translateY(0);
    opacity: 1;
  }

  .tile h3 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    letter-spacing: 0.2em;
  }

  .tile h3 a {
    color: #fff;
    border-bottom: none;
  }

  .tile h3 a:hover {
    color: #9bf1ff;
  }

  .tile p {
    font-size: 1.25rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1200px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .tiles {
      grid-template-columns: 1fr;
    }

    .tile {
      min-height: 250px;
    }

    .tile .major {
      transform: translateY(0);
      opacity: 1;
    }

    .tile h3 {
      font-size: 1.75rem;
    }

    .tile p {
      font-size: 1rem;
    }
  }
</style>
