---
import { siteConfig } from '../lib/config';

interface TileItem {
  href: string;
  title: string;
  description: string;
  image: string;
  external?: boolean;
}

interface Props {
  items?: TileItem[];
}

const defaultTiles: TileItem[] = [
  {
    href: '/infos/',
    title: '關於密式',
    description: '認識園區環境與特色設施',
    image: '/images/landing_banner.webp',
  },
  {
    href: '/rooms/',
    title: '房型展示',
    description: '比較營位、木屋與套房選擇',
    image: '/images/rooms.webp',
  },
  {
    href: '/sale_items/',
    title: '密式柑仔店',
    description: '查看租借用品、餐飲與代訂服務',
    image: '/images/sale_items.webp',
  },
  {
    href: '/infos/guide/',
    title: '交通指南',
    description: '出發前先確認路線與抵達方式',
    image: '/images/announcements.webp',
  },
  {
    href: '/galleries/',
    title: '密式圖集',
    description: '瀏覽園區、住宿與周邊實景',
    image: '/images/galleries.webp',
  },
  {
    href: siteConfig.booking.url,
    title: '空房查詢',
    description: '前往官方訂房系統確認日期與房況',
    image: '/images/booking.webp',
    external: true,
  },
];

const { items = defaultTiles } = Astro.props;
const displayItems = items.slice(0, siteConfig.tilesCount);
---

<section id="tiles" class="tiles">
  {displayItems.map((tile, index) => (
    <article
      class="tile"
      data-motion-card=""
      data-reveal=""
      style={`background-image: url('${tile.image}'); --motion-order: ${index}`}
    >
      <header class="major">
        <h2>
          <a
            href={tile.href}
            class="link primary"
            target={tile.external ? '_blank' : undefined}
            rel={tile.external ? 'noopener noreferrer' : undefined}
          >
            {tile.title}
          </a>
        </h2>
        <p>{tile.description}</p>
      </header>
    </article>
  ))}
</section>

<style>
  .tiles {
    display: flex;
    flex-wrap: wrap;
    border-top: 0;
  }

  .tile {
    position: relative;
    overflow: hidden;
    min-height: 23em;
    height: 40vh;
    max-height: 40em;
    width: 40%;
    display: flex;
    align-items: center;
    padding: 4em;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .tile:nth-child(4n - 1),
  .tile:nth-child(4n - 2) {
    flex: 1 auto;
  }

  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.85;
    z-index: 2;
    transition: opacity 0.5s ease;
  }

  .tile:hover::before,
  .tile:focus-within::before {
    opacity: 0.2;
  }

  .tile:nth-child(6n - 5)::before { background-color: #6fc3df; }
  .tile:nth-child(6n - 4)::before { background-color: #8d82c4; }
  .tile:nth-child(6n - 3)::before { background-color: #ec8d81; }
  .tile:nth-child(6n - 2)::before { background-color: #e7b788; }
  .tile:nth-child(6n - 1)::before { background-color: #8ea9e8; }
  .tile:nth-child(6n)::before { background-color: #87c5a4; }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle 260px at var(--motion-x) var(--motion-y),
        rgba(133, 205, 225, 0.24),
        transparent 64%
      ),
      radial-gradient(
        circle 180px at calc(100% - var(--motion-x)) calc(100% - var(--motion-y)),
        rgba(231, 168, 104, 0.14),
        transparent 70%
      ),
      linear-gradient(rgba(36, 41, 67, 0.25), rgba(36, 41, 67, 0.25));
    background-position: center, center, center;
    background-size: auto, auto, auto;
    z-index: 2;
    opacity: 0.42;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .tile:hover::after,
  .tile:focus-within::after { opacity: 0.88; }

  .tile .major {
    position: relative;
    z-index: 3;
    padding: 0;
    pointer-events: none;
  }

  .tile h2 {
    margin: 0 0 1rem;
    font-size: 2.5rem;
    letter-spacing: 0.15em;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
  }

  .tile h2 a {
    color: #fff;
    border-bottom: none;
    pointer-events: auto;
  }

  .tile h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tile h2 a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 0.35rem;
  }

  .tile p {
    margin: 0;
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.25rem;
  }

  @media (max-width: 1200px) {
    .tile {
      padding: 4em 3em;
      height: 30vh;
      max-height: 30em;
      min-height: 20em;
    }
  }

  @media (max-width: 980px) {
    .tile {
      width: 50%;
    }
  }

  @media (max-width: 736px) {
    .tiles {
      display: block;
    }

    .tile {
      width: 100%;
      height: 16em;
      max-height: none;
      min-height: 0;
      padding: 3em 1.5em;
    }

    .tile h2 {
      font-size: 1.5em;
    }

    .tile p {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .tile {
      height: 20em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      opacity: 1;
    }
  }
</style>
