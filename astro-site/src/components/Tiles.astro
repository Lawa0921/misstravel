---
import { siteConfig } from '../lib/config';

interface TileItem {
  href: string;
  title: string;
  description: string;
  image: string;
  external?: boolean;
}

interface Props {
  items?: TileItem[];
}

const defaultTiles: TileItem[] = [
  {
    href: '/infos/',
    title: '關於密式',
    description: '密式旅行，屬於你的景點',
    image: '/images/landing_banner.webp',
  },
  {
    href: '/rooms/',
    title: '房型展示',
    description: '密式旅行，位於群山的處所',
    image: '/images/rooms.webp',
  },
  {
    href: '/galleries/',
    title: '密式圖集',
    description: '密式旅行，之於心中的記憶',
    image: '/images/galleries.webp',
  },
  {
    href: '/announcements/',
    title: '最新消息',
    description: '密式旅行，自於群山的聲音',
    image: '/images/announcements.webp',
  },
  {
    href: siteConfig.booking.url,
    title: '空房查詢',
    description: '密式旅行，介於山巒的懷抱',
    image: '/images/booking.webp',
    external: true,
  },
];

const { items = defaultTiles } = Astro.props;
const displayItems = items.slice(0, siteConfig.tilesCount);
---

<section id="tiles" class="tiles">
  {displayItems.map((tile, index) => (
    <article class="tile" style={`animation-delay: ${index * 0.1}s`}>
      <span class="image">
        <img
          src={tile.image}
          alt={`${tile.title} - 密式旅行住宿選擇`}
          loading="lazy"
          decoding="async"
        />
      </span>
      <header class="major">
        <h3>
          <a
            href={tile.href}
            class="link"
            target={tile.external ? '_blank' : undefined}
            rel={tile.external ? 'noopener noreferrer' : undefined}
          >
            {tile.title}
          </a>
        </h3>
        <p>{tile.description}</p>
      </header>
    </article>
  ))}
</section>

<style>
  .tiles {
    display: flex;
    flex-wrap: wrap;
  }

  .tile {
    position: relative;
    overflow: hidden;
    min-height: 23em;
    height: 40vh;
    max-height: 40em;
    width: 40%;
    display: flex;
    align-items: center;
    padding: 4em;
    cursor: default;
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }

  .tile:nth-child(4n - 1),
  .tile:nth-child(4n - 2) {
    flex: 1 auto;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tile .image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .tile .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tile:hover .image img {
    transform: scale(1.05);
  }

  /* 彩色覆蓋層 - 仿照原始設計 */
  .tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    z-index: 1;
    transition: opacity 0.5s ease;
  }

  .tile:hover::before {
    opacity: 0;
  }

  /* 不同顏色的覆蓋層 */
  .tile:nth-child(6n - 5)::before { background-color: #6fc3df; }
  .tile:nth-child(6n - 4)::before { background-color: #8d82c4; }
  .tile:nth-child(6n - 3)::before { background-color: #ec8d81; }
  .tile:nth-child(6n - 2)::before { background-color: #e7b788; }
  .tile:nth-child(6n - 1)::before { background-color: #8ea9e8; }
  .tile:nth-child(6n)::before { background-color: #87c5a4; }

  /* 半透明背景層 */
  .tile::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(36, 41, 67, 0.25);
    z-index: 0;
  }

  .tile .major {
    position: relative;
    z-index: 3;
    padding: 0;
  }

  .tile h3 {
    font-size: 2.5rem;
    margin: 0 0 1rem;
    letter-spacing: 0.15em;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
  }

  .tile h3 a {
    color: #fff;
    border-bottom: none;
  }

  .tile h3 a:hover {
    color: inherit;
  }

  .tile p {
    font-size: 1.5rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 1200px) {
    .tile {
      padding: 4em 3em;
      height: 30vh;
      max-height: 30em;
      min-height: 20em;
    }
  }

  @media (max-width: 980px) {
    .tile {
      width: 50%;
    }
  }

  @media (max-width: 736px) {
    .tiles {
      display: block;
    }

    .tile {
      width: 100%;
      height: 16em;
      max-height: none;
      min-height: 0;
      padding: 3em 1.5em;
    }

    .tile h3 {
      font-size: 1.5em;
    }
  }

  @media (max-width: 480px) {
    .tile {
      height: 20em;
    }
  }
</style>
