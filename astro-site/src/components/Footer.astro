---
import { siteConfig } from '../lib/config';

const googleMapsUrl = 'https://www.google.com.tw/maps/place/%E5%AF%86%E5%BC%8F%E6%97%85%E8%A1%8C/@24.418704,120.9115453,17z';
---

<footer id="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-kicker">苗栗・泰安 / MissTravel</p>
      <h2>密式旅行</h2>
      <p>秘密景點，深度旅行</p>
    </div>

    <div class="footer-contact" data-footer-contact>
      <p class="footer-kicker">Stay in touch</p>
      <h2>聯絡與預訂</h2>
      <ul class="footer-actions" aria-label="預訂與聯絡方式">
        <li><a href={siteConfig.booking.url} class="footer-action" target="_blank" rel="noopener noreferrer">空房查詢</a></li>
        <li><a href={siteConfig.contact.lineUrl} class="footer-action line-action" target="_blank" rel="noopener noreferrer">LINE {siteConfig.contact.line}</a></li>
      </ul>
    </div>

    <ul class="icons" aria-label="密式旅行聯絡連結">
      <li>
        <a href={siteConfig.socials.facebook} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
        </a>
      </li>
      <li>
        <a href={siteConfig.socials.instagram} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </li>
      <li>
        <a href={`tel:${siteConfig.contact.phone}`} class="icon alt" aria-label="電話聯絡">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${siteConfig.contact.email}`} class="icon alt" aria-label="Email 聯絡">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href={googleMapsUrl} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Google 地圖位置">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </a>
      </li>
    </ul>

    <p class="footer-meta"><span>© {siteConfig.title}</span><span>苗栗・泰安</span></p>
  </div>
</footer>

<style>
  #footer { padding: clamp(3rem, 6vw, 5rem) 0 2rem; background: #1c2034; }
  .footer-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem clamp(2rem, 8vw, 8rem); width: min(78rem, calc(100% - 2.5rem)); margin: 0 auto; }
  .footer-kicker { margin: 0 0 0.75rem; color: var(--color-aqua); font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; }
  .footer-brand h2, .footer-contact h2 { margin: 0; color: var(--color-paper); font-size: clamp(1.25rem, 2vw, 1.7rem); font-weight: 500; letter-spacing: 0.14em; }
  .footer-brand > p:last-child { margin: 0.7rem 0 0; color: var(--color-paper-muted); font-size: 0.9rem; letter-spacing: 0.1em; }
  .footer-actions, .icons { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .footer-action { display: inline-flex; min-width: 7.5rem; min-height: 2.75rem; align-items: center; justify-content: center; padding: 0.55rem 1rem; border: 1px solid var(--color-paper); color: var(--color-paper); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; }
  .footer-action:hover, .footer-action:focus-visible { background: var(--color-paper); color: var(--color-bg); }
  .line-action { border-color: var(--color-aqua); }
  .icons { grid-column: 1 / -1; align-items: center; gap: 0.65rem; margin-top: 1rem; padding-top: 1.5rem; border-top: 1px solid rgba(245, 240, 230, 0.16); }
  .icon.alt { display: inline-flex; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center; border: 1px solid rgba(245, 240, 230, 0.35); color: var(--color-paper); }
  .icon.alt:hover, .icon.alt:focus-visible { border-color: var(--color-aqua); background: rgba(157, 216, 208, 0.1); color: var(--color-aqua); }
  .icon.alt svg { width: 1rem; height: 1rem; }
  .footer-meta { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 1rem; margin: 0; color: var(--color-paper-muted); font-size: 0.8rem; letter-spacing: 0.12em; }

  @media (max-width: 767px) {
    .footer-inner { display: block; width: calc(100% - 2.5rem); }
    .footer-contact { margin-top: 2.25rem; }
    .icons { margin-top: 2.25rem; }
    .footer-meta { margin-top: 1.25rem; }
  }

  @media (max-width: 390px) {
    .footer-meta { flex-direction: column; gap: 0.35rem; }
  }
</style>
