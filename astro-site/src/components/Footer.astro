---
import { siteConfig } from '../lib/config';

const googleMapsUrl = 'https://www.google.com.tw/maps/place/%E5%AF%86%E5%BC%8F%E6%97%85%E8%A1%8C/@24.418704,120.9115453,17z';
---

<footer id="footer">
  <div class="inner">
    <ul class="icons align-center">
      <li>
        <a
          href={siteConfig.socials.facebook}
          class="icon alt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={siteConfig.socials.instagram}
          class="icon alt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={siteConfig.socials.github}
          class="icon alt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={`tel:${siteConfig.contact.phone}`}
          class="icon alt"
          aria-label="電話聯絡"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="icon alt"
          aria-label="Email 聯絡"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={googleMapsUrl}
          class="icon alt"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google 地圖位置"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </a>
      </li>
      <li>
        <strong>Line ID: {siteConfig.contact.line}</strong>
      </li>
      <li>
        <strong>&copy; {siteConfig.title}</strong>
      </li>
    </ul>
  </div>
</footer>

</div> <!-- Close #wrapper from Header -->

<style>
  #footer {
    padding: 2em 0;
    background: #1e2234;
  }

  #footer .inner {
    max-width: 65em;
    margin: 0 auto;
    padding: 0 3em;
  }

  #footer .icons.align-center {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    cursor: default;
  }

  #footer .icons li {
    display: inline-block;
    padding: 0 1em 0 0;
  }

  #footer .icons li:last-child {
    padding-right: 0;
  }

  #footer .icons li strong {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8em;
    letter-spacing: 0.25em;
  }

  #footer .icon.alt {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    background-color: #fff;
    border-radius: 100%;
    color: #242943;
    transition: background-color 0.2s ease;
    text-decoration: none;
    border: none;
  }

  #footer .icon.alt:hover {
    background-color: #6fc3df;
  }

  #footer .icon.alt svg {
    width: 1em;
    height: 1em;
  }

  @media (max-width: 768px) {
    #footer {
      padding: 1.5em 0;
    }

    #footer .inner {
      padding: 0 1.5em;
    }

    #footer .icons.align-center {
      gap: 0.5em;
    }

    #footer .icon.alt {
      width: 2em;
      height: 2em;
    }
  }
</style>
