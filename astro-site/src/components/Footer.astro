---
import { siteConfig } from '../lib/config';

const googleMapsUrl = 'https://www.google.com.tw/maps/place/%E5%AF%86%E5%BC%8F%E6%97%85%E8%A1%8C/@24.418704,120.9115453,17z';
---

<footer id="footer">
  <div class="inner">
    <ul class="icons align-center">
      <li>
        <a href={siteConfig.booking.url} class="footer-action" target="_blank" rel="noopener noreferrer">空房查詢</a>
      </li>
      <li>
        <a href={siteConfig.contact.lineUrl} class="footer-action line-action" target="_blank" rel="noopener noreferrer">LINE {siteConfig.contact.line}</a>
      </li>
      <li>
        <a href={siteConfig.socials.facebook} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
        </a>
      </li>
      <li>
        <a href={siteConfig.socials.instagram} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </li>
      <li>
        <a href={`tel:${siteConfig.contact.phone}`} class="icon alt" aria-label="電話聯絡">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${siteConfig.contact.email}`} class="icon alt" aria-label="Email 聯絡">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href={googleMapsUrl} class="icon alt" target="_blank" rel="noopener noreferrer" aria-label="Google 地圖位置">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </a>
      </li>
      <li><strong>&copy; {siteConfig.title}</strong></li>
    </ul>
  </div>
</footer>

<style>
  #footer { padding: 2em 0; background: #1e2234; }
  #footer .inner { max-width: 65em; margin: 0 auto; padding: 0 3em; }
  #footer .icons.align-center { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 0.75rem; list-style: none; padding: 0; margin: 0; }
  #footer .icons li { display: inline-block; }
  #footer .icons li strong { color: rgba(255, 255, 255, 0.65); font-size: 0.8em; letter-spacing: 0.15em; }
  #footer .icon.alt { display: flex; align-items: center; justify-content: center; width: 2.25em; height: 2.25em; background-color: #fff; border-radius: 100%; color: #242943; transition: background-color 0.2s ease; text-decoration: none; border: none; }
  #footer .icon.alt:hover,
  #footer .icon.alt:focus-visible { background-color: #9bf1ff; }
  #footer .icon.alt svg { width: 1em; height: 1em; }
  .footer-action { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.4rem 1rem; border: 2px solid #fff; font-weight: 600; letter-spacing: 0.12em; }
  .footer-action:hover,
  .footer-action:focus-visible { background: #fff; color: #242943; }
  .line-action { border-color: #9bf1ff; }

  @media (max-width: 768px) {
    #footer { padding: 1.5em 0; }
    #footer .inner { padding: 0 1.5em; }
    #footer .icons.align-center { gap: 0.6em; }
  }
</style>
