---
import { siteConfig } from '../lib/config';

interface Props {
  variant?: 'default' | 'alt' | 'alt-style2';
}

const { variant = 'default' } = Astro.props;
const headerClass = variant === 'alt' ? 'alt' : variant === 'alt-style2' ? 'alt style2' : '';
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/infos/', label: '關於密式' },
  { href: '/rooms/', label: '房型展示' },
  { href: '/sale_items/', label: '密式柑仔店' },
  { href: '/infos/guide/', label: '交通指南' },
  { href: '/galleries/', label: '密式圖集' },
  { href: siteConfig.booking.url, label: '空房查詢', external: true },
];

const desktopItems = ['/', '/rooms/', '/infos/', '/galleries/']
  .map((href) => navItems.find((item) => item.href === href)!);
const isCurrent = (href: string, external = false) => !external && currentPath === href;
---

<header id="header" class={headerClass}>
  <a href="/" class="logo" aria-label="回到密式旅行首頁"><strong>MISSTRAVEL</strong></a>
  <nav id="desktop-nav" aria-label="主要導覽">
    {desktopItems.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href, item.external) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="menu-control">
    <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Menu 選單">Menu</button>
  </div>
</header>

<nav id="menu" aria-label="選單" aria-hidden="true" tabindex="-1">
  <button type="button" class="close" id="menu-close" aria-label="關閉選單"></button>
  <ul class="links">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={isCurrent(item.href, item.external) ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  #header { display: flex; align-items: center; position: absolute; z-index: 1000; top: 0; left: 0; width: 100%; height: 4.5rem; padding: 0 max(1.25rem, 5vw); color: var(--color-paper); letter-spacing: 0.12em; }
  #header:not(.alt) { position: fixed; background: var(--color-bg); box-shadow: 0 1px 0 rgba(245, 240, 230, 0.12); }
  #header.alt { background: linear-gradient(180deg, rgba(36, 41, 67, 0.74), transparent); }
  #header.alt.style2 .logo strong { color: var(--color-champagne); }

  .logo { flex: 0 0 auto; min-height: 2.75rem; display: inline-flex; align-items: center; border: 0; font-size: 0.78rem; letter-spacing: 0.2em; }
  .logo strong { padding: 0.35rem 0.5rem 0.35rem 0.65rem; background: var(--color-paper); color: var(--color-bg); font-weight: 600; transition: background-color var(--transition-fast), color var(--transition-fast); }
  .logo:hover strong, .logo:focus-visible strong { background: var(--color-aqua); color: var(--color-bg); }

  #desktop-nav { display: flex; align-items: center; justify-content: flex-end; gap: clamp(0.7rem, 2vw, 1.8rem); flex: 1; margin-left: 2rem; }
  #desktop-nav a { min-height: 2.75rem; display: inline-flex; align-items: center; border: 0; color: var(--color-paper-muted); font-size: 0.875rem; letter-spacing: 0.1em; white-space: nowrap; transition: color var(--transition-fast); }
  #desktop-nav a:hover, #desktop-nav a:focus-visible, #desktop-nav a[aria-current='page'] { color: var(--color-aqua); }
  #desktop-nav a[aria-current='page']::after { content: ''; align-self: flex-end; width: 1.4rem; height: 2px; margin-left: -1.4rem; margin-bottom: 0.55rem; background: var(--color-champagne); transform: translateX(0.1rem); }

  .menu-control { display: flex; align-items: center; margin-left: 1.2rem; }
  #menu-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 5.5rem;
    min-height: 2.75rem;
    padding: 0 2.25rem 0 0.5rem;
    border: 0;
    border-radius: 0.25rem;
    box-shadow: none;
    background: transparent;
    color: var(--color-paper);
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }
  #menu-toggle::before, #menu-toggle::after {
    content: '';
    position: absolute;
    right: 0.35rem;
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    transform-origin: right center;
    transition: transform var(--transition-fast);
  }
  #menu-toggle::before { top: calc(50% - 0.25rem); }
  #menu-toggle::after { top: calc(50% + 0.25rem); transform: scaleX(0.72); }
  #menu-toggle:hover, #menu-toggle:focus-visible { color: var(--color-aqua); }
  #menu-toggle:hover::after, #menu-toggle:focus-visible::after { transform: scaleX(1); }
  /* No decorative border; keyboard focus must still be visible. */
  #menu-toggle:focus-visible { outline: 2px solid var(--color-aqua); outline-offset: 4px; }

  #menu { position: fixed; inset: 0; z-index: 10001; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100vh; padding: 6rem 2rem 2rem; background: rgba(36, 41, 67, 0.98); opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0s linear 0.3s; }
  #menu.is-visible { opacity: 1; visibility: visible; transition-delay: 0s; }
  #menu .links { width: min(28rem, 100%); margin: 0; padding: 0; list-style: none; text-align: center; }
  #menu .links li { margin: 0; }
  #menu .links a { display: block; min-height: 2.75rem; padding: 0.8rem 1rem; border-bottom: 1px solid rgba(245, 240, 230, 0.15); color: var(--color-paper); font-size: 1rem; letter-spacing: 0.16em; }
  #menu .links a:hover, #menu .links a:focus-visible, #menu .links a[aria-current='page'] { background: rgba(157, 216, 208, 0.1); color: var(--color-aqua); }
  #menu .close { position: absolute; top: 1.5rem; right: max(1.25rem, 5vw); width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  #menu .close::before, #menu .close::after { content: ''; position: absolute; top: 50%; left: 0.45rem; width: 1.8rem; height: 1px; background: var(--color-paper); }
  #menu .close::before { transform: rotate(45deg); }
  #menu .close::after { transform: rotate(-45deg); }
  #menu .close:hover { background: rgba(157, 216, 208, 0.1); }
  #menu .close:focus-visible { outline: 2px solid var(--color-aqua); outline-offset: 4px; }
  #menu .close:hover::before, #menu .close:hover::after, #menu .close:focus-visible::before, #menu .close:focus-visible::after { background: var(--color-aqua); }

  @media (max-width: 1020px) {
    #header { padding-inline: 1.25rem; }
    #desktop-nav { gap: 0.75rem; margin-left: 1rem; }
    #desktop-nav a { font-size: 0.8125rem; letter-spacing: 0.05em; }
  }

  @media (max-width: 767px) {
    #header { height: 4rem; padding-inline: 1.25rem; }
    #desktop-nav { display: none; }
    .menu-control { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    #menu, #desktop-nav a, .logo strong, #menu-toggle, #menu-toggle::before, #menu-toggle::after { transition: none; }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menuClose = document.getElementById('menu-close') as HTMLButtonElement | null;
  const menu = document.getElementById('menu');
  const menuFocusableSelector = [
    'a[href]',
    'button:not([disabled])',
    'input:not([disabled])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    '[tabindex]:not([tabindex="-1"])',
  ].join(',');

  function getMenuFocusableElements() {
    if (!menu) return [];
    return Array.from(menu.querySelectorAll<HTMLElement>(menuFocusableSelector)).filter((element) => {
      const style = window.getComputedStyle(element);
      return !element.hidden && element.getAttribute('aria-hidden') !== 'true' && style.display !== 'none' && style.visibility !== 'hidden';
    });
  }

  function closeMenu() {
    if (!menu?.classList.contains('is-visible')) return;
    menu.classList.remove('is-visible');
    menu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.focus({ preventScroll: true });
  }

  function focusMenuCloseWhenVisible() {
    let attempts = 0;
    const focusWhenReady = () => {
      if (!menu?.classList.contains('is-visible')) return;
      menuClose?.focus({ preventScroll: true });
      // Reduced-motion CSS can defer visibility for a frame. Do not leave focus
      // outside the open menu, and never steal it back after the menu closes.
      if (document.activeElement !== menuClose && attempts++ < 30) {
        requestAnimationFrame(focusWhenReady);
      }
    };
    requestAnimationFrame(focusWhenReady);
  }

  function openMenu() {
    menu?.classList.add('is-visible');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    menuToggle?.setAttribute('aria-expanded', 'true');
    focusMenuCloseWhenVisible();
  }

  menuToggle?.addEventListener('click', () => {
    if (menu?.classList.contains('is-visible')) closeMenu();
    else openMenu();
  });

  menuClose?.addEventListener('click', closeMenu);

  // Capture a clean page on native document transitions, not a fading menu.
  // Also leaves a closed, unlocked document for the browser's back/forward cache.
  window.addEventListener('pageswap', () => {
    closeMenu();
    menu?.getAnimations().forEach((animation) => animation.finish());
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (!link.getAttribute('target')) closeMenu();
    });
  });

  menu?.addEventListener('keydown', (event) => {
    if (!menu.classList.contains('is-visible')) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeMenu();
      return;
    }

    if (event.key !== 'Tab') return;

    const focusables = getMenuFocusableElements();
    if (focusables.length === 0) {
      event.preventDefault();
      menu.focus({ preventScroll: true });
      return;
    }

    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const activeElement = document.activeElement;

    if (!menu.contains(activeElement)) {
      event.preventDefault();
      first.focus({ preventScroll: true });
    } else if (event.shiftKey && activeElement === first) {
      event.preventDefault();
      last.focus({ preventScroll: true });
    } else if (!event.shiftKey && activeElement === last) {
      event.preventDefault();
      first.focus({ preventScroll: true });
    }
  });
</script>
