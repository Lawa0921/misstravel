---
import { siteConfig } from '../../lib/config';

interface Props {
  type: 'Organization' | 'LocalBusiness' | 'Accommodation' | 'BlogPosting';
  data?: Record<string, unknown>;
  extraSchemas?: Record<string, unknown>[];
}

const { type, data = {}, extraSchemas = [] } = Astro.props;

const baseOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.author,
  url: siteConfig.url,
  logo: `${siteConfig.url}${siteConfig.logo}`,
  sameAs: [
    siteConfig.socials.facebook,
    siteConfig.socials.instagram,
    siteConfig.contact.lineUrl,
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteConfig.contact.phone,
    email: siteConfig.contact.email,
    contactType: 'customer service',
    availableLanguage: ['Chinese'],
  },
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: siteConfig.author,
  description: siteConfig.description,
  url: siteConfig.url,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '苗栗縣泰安鄉大興村高熊卡6號',
    addressLocality: '泰安鄉',
    addressRegion: '苗栗縣',
    postalCode: '365',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.418704,
    longitude: 120.913734,
  },
  priceRange: '$$',
  image: `${siteConfig.url}${siteConfig.logo}`,
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '桌遊咖啡廳', value: true },
    { '@type': 'LocationFeatureSpecification', name: '兒童遊戲室', value: true },
    { '@type': 'LocationFeatureSpecification', name: '兒童沙坑', value: true },
    { '@type': 'LocationFeatureSpecification', name: '免費停車', value: true },
    { '@type': 'LocationFeatureSpecification', name: '免費 Wi-Fi', value: true },
    { '@type': 'LocationFeatureSpecification', name: '多肉植物小舖', value: true },
  ],
};

const schemas: Record<string, object> = {
  Organization: baseOrganization,
  LocalBusiness: localBusiness,
  Accommodation: { ...localBusiness, '@type': 'Accommodation', ...data },
  BlogPosting: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    publisher: baseOrganization,
    ...data,
  },
};

const schema = schemas[type] || baseOrganization;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{extraSchemas.map((extra) => (
  <script type="application/ld+json" set:html={JSON.stringify(extra)} />
))}
