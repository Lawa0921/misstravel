---
import { siteConfig } from '../../lib/config';

interface Props {
  type: 'Organization' | 'LocalBusiness' | 'Accommodation' | 'BlogPosting';
  data?: Record<string, unknown>;
  extraSchemas?: Record<string, unknown>[];
}

const { type, data = {}, extraSchemas = [] } = Astro.props;

const baseOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.author,
  url: siteConfig.url,
  logo: `${siteConfig.url}${siteConfig.logo}`,
  sameAs: [
    siteConfig.socials.facebook,
    siteConfig.socials.instagram,
    siteConfig.contact.lineUrl,
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteConfig.contact.phone,
    email: siteConfig.contact.email,
    contactType: 'customer service',
    availableLanguage: ['Chinese'],
  },
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: siteConfig.author,
  description: siteConfig.description,
  url: siteConfig.url,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '苗栗縣泰安鄉大興村高熊卡6號',
    addressLocality: '泰安鄉',
    addressRegion: '苗栗縣',
    postalCode: '365',
    addressCountry: 'TW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.418704,
    longitude: 120.913734,
  },
  priceRange: '$$',
  image: `${siteConfig.url}${siteConfig.logo}`,
  checkinTime: '15:00',
  checkoutTime: '12:00',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '桌遊咖啡廳', value: true },
    { '@type': 'LocationFeatureSpecification', name: '兒童遊戲室', value: true },
    { '@type': 'LocationFeatureSpecification', name: '兒童沙坑', value: true },
    { '@type': 'LocationFeatureSpecification', name: '免費停車', value: true },
    { '@type': 'LocationFeatureSpecification', name: '免費 Wi-Fi', value: true },
    { '@type': 'LocationFeatureSpecification', name: '多肉植物小舖', value: true },
  ],
};

const bookingFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '如何完成訂房？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '線上訂房系統提供目前空房查詢。確認日期與房型後，請透過 LINE 官方帳號 @rys8178b 或 Facebook「密式旅行農場」聯絡，由密式旅行回覆房型、金額與訂金期限。完成匯款後請回到原本的 LINE 或 Facebook 對話通知；收到密式旅行的訂位確認後才代表預訂完成。',
      },
    },
    {
      '@type': 'Question',
      name: '匯款後如何回報？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '請使用原本建立訂位聯繫的管道回報。使用 LINE 聯絡者回到原 LINE 對話；使用 Facebook 聯絡者回到原 Messenger 對話，以便在同一段對話中核對訂位資料。',
      },
    },
    {
      '@type': 'Question',
      name: '退費規定為何？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '入住日前 14 天含以上取消，扣除單次退款手續費後退還訂金；12 至 13 天前扣 30%；9 至 11 天前扣 50%；6 至 8 天前扣 60%；3 至 5 天前扣 70%；1 至 2 天前扣 80%；入住當日取消不退款。遇颱風或豪大雨時依園區公告辦理退費或延期。',
      },
    },
  ],
};

const schemas: Record<string, object> = {
  Organization: baseOrganization,
  LocalBusiness: localBusiness,
  Accommodation: { ...localBusiness, '@type': 'Accommodation', ...data },
  BlogPosting: {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    publisher: baseOrganization,
    ...data,
  },
};

const schema = schemas[type] || baseOrganization;
const normalizedExtraSchemas = extraSchemas.map((extra) => {
  if (Astro.url.pathname === '/infos/account/' && extra['@type'] === 'FAQPage') {
    return bookingFaq;
  }
  return extra;
});
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{normalizedExtraSchemas.map((extra) => (
  <script type="application/ld+json" set:html={JSON.stringify(extra)} />
))}
