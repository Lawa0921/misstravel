---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import '../../styles/guest-pages.css';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../lib/config';

const announcements = await getCollection('announcements');
const sortedAnnouncements = announcements.sort(
  (a, b) => new Date(b.data.datetime).getTime() - new Date(a.data.datetime).getTime()
);

function formatDate(date: Date): string {
  const year = date.getFullYear();
  const month = date.toLocaleString('en', { month: 'short' });
  const day = date.getDate();
  return `${year} ${month} ${day}`;
}

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: sortedAnnouncements.map((announcement, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: announcement.data.title,
    url: `${siteConfig.url}/announcements/${announcement.id.replace('.md', '')}/`,
  })),
};
---

<BaseLayout
  title="最新消息"
  description="密式旅行露營區最新公告與活動消息"
  keywords="密式旅行公告,露營區消息,最新活動"
  extraSchemas={[itemListSchema]}
>
  <main id="main" class="guest-page">
    <section id="one">
      <div class="guest-wrap">
        <Breadcrumb items={[{ label: '最新消息' }]} />
        <div class="jumbotron">
          <header class="guest-header">
            <h1>最新消息</h1>
          </header>
        </div>
        <div class="announcements-list">
          {sortedAnnouncements.map((announcement) => (
            <article class="announcement-card">
              <div class="card-body">
                <h2>{announcement.data.title}</h2>
                <p class="description">{announcement.data.description}</p>
                <time class="date" datetime={announcement.data.datetime.toISOString()}>{formatDate(announcement.data.datetime)}</time>
                <a href={`/announcements/${announcement.id.replace('.md', '')}/`} class="button special small">
                  前往查看
                </a>
              </div>
              {announcement.data.image && (
                <div class="card-image">
                  <img
                    src={announcement.data.image}
                    alt={announcement.data.title}
                    loading="lazy"
                    decoding="async"
                    width="200"
                    height="250"
                  />
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>

.announcements-list { display:grid; gap:1.5rem; }
.announcement-card { position:relative; display:grid; grid-template-columns:1.2fr 1fr; overflow:hidden; border:1px solid var(--color-border); border-radius:1rem; background:var(--color-surface); }
.card-body { padding:clamp(1.5rem,4vw,3rem); display:flex; flex-direction:column; align-items:flex-start; }
.card-body h2 { font-size:clamp(1.4rem,2.5vw,2rem); line-height:1.5; margin:0 0 1.25rem; }
.card-body .description { font-size:1.05rem; line-height:1.85; color:var(--color-paper-muted); margin-bottom:1.5rem; }
.card-body .date { color:var(--color-champagne); font-size:.9rem; margin:auto 0 1.25rem; }
.button.special.small { display:inline-flex; align-items:center; min-height:44px; padding:.65rem 1.25rem; border:1px solid var(--color-aqua); border-radius:99px; color:var(--color-aqua); font-weight:600; }
.button::after { content:''; position:absolute; inset:0; }
.announcement-card:has(a:hover), .announcement-card:has(a:focus-visible) { border-color:var(--color-aqua); }
.card-image { min-height:310px; }
.card-image img { width:100%; height:100%; object-fit:cover; display:block; }
@media(max-width:640px) { .announcement-card { grid-template-columns:1fr; } .card-image { order:-1; min-height:0; aspect-ratio:16/9; } .card-body { padding:1.5rem; } }
</style>
