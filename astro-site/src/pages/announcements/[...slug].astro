---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import '../../styles/guest-pages.css';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../lib/config';

export async function getStaticPaths() {
  const announcements = await getCollection('announcements');
  return announcements.map((announcement) => ({
    params: { slug: announcement.id.replace('.md', '') },
    props: { announcement },
  }));
}

const { announcement } = Astro.props;
const { Content } = await render(announcement);

const blogPostingData = {
  headline: announcement.data.title,
  description: announcement.data.description,
  datePublished: announcement.data.datetime.toISOString(),
  ...(announcement.data.image ? { image: `${siteConfig.url}${announcement.data.image}` } : {}),
};

const articleMeta = {
  publishedTime: announcement.data.datetime.toISOString(),
  author: '密式旅行',
  tags: announcement.data.tags || [],
};
---

<BaseLayout
  title={announcement.data.metaTitle || announcement.data.title}
  description={announcement.data.description}
  image={announcement.data.image}
  type="article"
  schemaType="BlogPosting"
  schemaData={blogPostingData}
  articleMeta={articleMeta}
>
  <main id="main" class="guest-page article-page">
  <section class="page-header">
    <div class="guest-wrap">
      <Breadcrumb items={[
        { label: '最新消息', href: '/announcements/' },
        { label: announcement.data.title }
      ]} />
      <h1>{announcement.data.title}</h1>
      <div class="meta">
        <time datetime={announcement.data.datetime.toISOString()}>
          {announcement.data.datetime.toLocaleDateString('zh-TW', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <div class="tags">
          {announcement.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </section>


    <div class="guest-wrap article-content">
      {announcement.data.image && (
        <div class="featured-image">
          <img src={announcement.data.image} alt={announcement.data.title} loading="lazy" decoding="async" width="800" height="450" />
        </div>
      )}
      <div class="content guest-content">
        <Content />
      </div>
      <div class="back-link">
        <a href="/announcements/">← 返回最新消息</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>

.page-header h1 { margin:2rem 0 1.5rem; font-size:clamp(2rem,4vw,3.4rem); line-height:1.3; text-wrap:balance; }
.page-header .meta { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; color:var(--color-paper-muted); font-size:.95rem; margin-bottom:2rem; }
.tags { display:flex; gap:.5rem; } .tag { padding:.35rem .7rem; border:1px solid var(--color-border); color:var(--color-aqua); border-radius:99px; font-size:.85rem; }
.article-content { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:2rem; align-items:start; }
.featured-image { position:sticky; top:6rem; overflow:hidden; border:1px solid var(--color-border); border-radius:1rem; }
.featured-image img { display:block; width:100%; height:auto; }
.back-link { grid-column:1/-1; padding-block:1rem; }
.back-link a { display:inline-flex; min-height:44px; align-items:center; color:var(--color-aqua); }
@media(max-width:900px) { .article-content { grid-template-columns:1fr; } .featured-image { position:static; } }
</style>
