---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuestNavigation from '../../components/GuestNavigation.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../lib/config';

export async function getStaticPaths() {
  const infos = await getCollection('infos');
  return infos.map((info) => ({
    params: { slug: info.id.replace('.md', '') },
    props: { info },
  }));
}

const { info } = Astro.props;
const { Content } = await render(info);

const slug = info.id.replace('.md', '');
const extraSchemas: Record<string, unknown>[] = [];

if (slug === 'video') {
  extraSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: '密式旅行露營區園區介紹影片',
    description: info.data.metaDescription || info.data.description,
    thumbnailUrl: `https://img.youtube.com/vi/0uTQjhD95c0/maxresdefault.jpg`,
    uploadDate: '2017-11-07T00:26:31-08:00',
    duration: 'PT2M37S',
    embedUrl: 'https://www.youtube.com/embed/0uTQjhD95c0',
    publisher: {
      '@type': 'Organization',
      name: '密式旅行',
      url: siteConfig.url,
    },
  });
}
---

<BaseLayout
  title={info.data.metaTitle || info.data.title}
  description={info.data.metaDescription || info.data.description}
  image={info.data.image || undefined}
  keywords={info.data.keywords}
  extraSchemas={extraSchemas.length > 0 ? extraSchemas : undefined}
>
  <main id="main" class="guest-page">
    <div class="guest-wrap">
      <Breadcrumb items={[{label:'關於密式',href:'/infos/'},{label:info.data.title}]} />
      <header class="guest-header"><h1>{info.data.title}</h1></header>
      <div class="guest-layout">
        <aside class="guest-sidebar"><GuestNavigation /></aside>
        <div>
          <div class="info-content guest-content" data-info={slug}><Content /></div>
          {['map','menu'].includes(slug) && info.data.image && <a class="media-action" href={info.data.image} target="_blank" rel="noopener noreferrer">查看原圖 <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
