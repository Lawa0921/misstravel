---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuestNavigation from '../../components/GuestNavigation.astro';
const menus = [{id:'set_menu_1',name:'家庭合菜',image:'/images/set_menu_1.webp'},{id:'set_menu_2',name:'經濟合菜',image:'/images/set_menu_2.webp'},{id:'set_menu_3',name:'精緻合菜',image:'/images/set_menu_3.webp'}];
---

<BaseLayout
  title="代訂合菜"
  description="密式旅行露營區提供代訂合菜服務，包含家庭、經濟、精緻三種合菜選擇"
  keywords="密式旅行合菜, 露營區合菜, 苗栗合菜, 泰安露營用餐, 露營合菜預訂"
>
  <main id="main" class="guest-page">
    <div class="guest-wrap">
      <Breadcrumb items={[{label:'關於密式',href:'/infos/'},{label:'代訂合菜'}]} />
      <header class="guest-header"><h1>代訂合菜</h1></header>
      <div class="guest-layout">
        <aside class="guest-sidebar"><GuestNavigation /></aside>
        <div>
          <div class="info-section guest-notice">
          <h4>最少需預訂5000元才接單 【含清潔費用】</h4>
          <ul>
            <li>每桌需另加２００元清潔費</li>
            <li>小朋友餐具需自備，餐廳提供的餐具皆為瓷碗瓷盤</li>
            <li>如需預訂請"提前"來電告知</li>
            <li>菜色皆由公館鄉上來客饌製作，密式提供餐點運送、用餐環境</li>
            <li>無提供菜單上沒有的餐點</li>
          </ul>
        </div>
          <div class="menu-buttons guest-choice-grid">
            {menus.map((menu) => <button type="button" class="menu-btn guest-choice" data-modal={menu.id} aria-label={menu.name}>
              <span class="guest-choice-media"><img src={menu.image} alt="" loading="lazy" decoding="async" width="600" height="800" /></span>
              <span class="guest-choice-title">{menu.name}</span>
              <span class="guest-choice-detail">查看菜單 <span aria-hidden="true">↗</span></span>
            </button>)}
          </div>
        </div>
      </div>
    </div>

  <!-- Modal: 家庭合菜 -->
  <div class="modal" id="set_menu_1" role="dialog" aria-modal="true" aria-labelledby="set_menu_1-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_1-title">家庭合菜</h2>
        <button type="button" class="modal-close" aria-label="關閉對話框">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_1.webp" alt="家庭合菜 $2,200" loading="lazy" decoding="async" width="600" height="800" />
      </div>
    </div>
  </div>

  <!-- Modal: 經濟合菜 -->
  <div class="modal" id="set_menu_2" role="dialog" aria-modal="true" aria-labelledby="set_menu_2-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_2-title">經濟合菜</h2>
        <button type="button" class="modal-close" aria-label="關閉對話框">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_2.webp" alt="經濟合菜 $3,800" loading="lazy" decoding="async" width="600" height="800" />
      </div>
    </div>
  </div>

  <!-- Modal: 精緻合菜 -->
  <div class="modal" id="set_menu_3" role="dialog" aria-modal="true" aria-labelledby="set_menu_3-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_3-title">精緻合菜</h2>
        <button type="button" class="modal-close" aria-label="關閉對話框">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_3.webp" alt="精緻合菜 $4,200" loading="lazy" decoding="async" width="600" height="800" />
      </div>
    </div>
  </div>
  </main>
</BaseLayout>



<script>
  function openModal(modal: HTMLElement) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function closeAllModals() {
    document.querySelectorAll('.modal.active').forEach(modal => {
      closeModal(modal as HTMLElement);
    });
  }

  document.querySelectorAll('.menu-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-modal');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (modal) openModal(modal);
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = btn.closest('.modal') as HTMLElement | null;
      if (modal) closeModal(modal);
    });
  });

  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal as HTMLElement);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllModals();
  });
</script>
