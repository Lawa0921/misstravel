---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="代訂合菜"
  description="密式旅行露營區提供代訂合菜服務，包含家庭、經濟、精緻三種合菜選擇"
  keywords="密式旅行合菜, 露營區合菜, 苗栗合菜, 泰安露營用餐, 露營合菜預訂"
>
  <main id="main" class="alt">
    <section id="one">
      <div class="inner">
        <Breadcrumb items={[
          { label: '關於密式', href: '/infos/' },
          { label: '代訂合菜' }
        ]} />
        <header class="major">
          <h1>代訂合菜</h1>
        </header>

        <div class="info-section">
          <h4>最少需預訂5000元才接單 【含清潔費用】</h4>
          <ul>
            <li>每桌需另加２００元清潔費</li>
            <li>小朋友餐具需自備，餐廳提供的餐具皆為瓷碗瓷盤</li>
            <li>如需預訂請"提前"來電告知</li>
            <li>菜色皆由公館鄕上來客饌製作，密式提供餐點運送、用餐環境</li>
            <li>無提供菜單上沒有的餐點</li>
          </ul>
        </div>

        <div class="menu-buttons">
          <button type="button" class="menu-btn special" data-modal="set_menu_1">家庭合菜</button>
          <button type="button" class="menu-btn" data-modal="set_menu_2">經濟合菜</button>
          <button type="button" class="menu-btn special" data-modal="set_menu_3">精緻合菜</button>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal: 家庭合菜 -->
  <div class="modal" id="set_menu_1" role="dialog" aria-modal="true" aria-labelledby="set_menu_1-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_1-title">家庭合菜</h2>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_1.webp" alt="家庭合菜 $2,200" loading="lazy" width="600" height="800" />
      </div>
    </div>
  </div>

  <!-- Modal: 經濟合菜 -->
  <div class="modal" id="set_menu_2" role="dialog" aria-modal="true" aria-labelledby="set_menu_2-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_2-title">經濟合菜</h2>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_2.webp" alt="經濟合菜 $3,800" loading="lazy" width="600" height="800" />
      </div>
    </div>
  </div>

  <!-- Modal: 精緻合菜 -->
  <div class="modal" id="set_menu_3" role="dialog" aria-modal="true" aria-labelledby="set_menu_3-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="set_menu_3-title">精緻合菜</h2>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <img src="/images/set_menu_3.webp" alt="精緻合菜 $4,200" loading="lazy" width="600" height="800" />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  #main.alt {
    background: #242943;
    padding-top: 5rem;
  }

  #one {
    padding: 2rem 0 4rem;
  }

  .inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .major h1 {
    font-size: 2rem;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #fff;
    display: inline-block;
    padding-bottom: 0.5rem;
  }

  .info-section {
    margin-bottom: 2rem;
    background: #2a2f4a;
    border-radius: 8px;
    padding: 1.5rem 2rem;
    line-height: 1.8;
  }

  .info-section h4 {
    color: #ffd306;
    margin-bottom: 1rem;
    font-size: 1.05em;
  }

  .info-section ul {
    padding-left: 1.5rem;
    margin-bottom: 0;
  }

  .info-section li {
    margin-bottom: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .info-section li::marker {
    color: #9bf1ff;
  }

  .menu-buttons {
    display: flex;
    justify-content: center;
    gap: 2rem;
    min-height: 300px;
    align-items: center;
    flex-wrap: wrap;
    background: #2a2f4a;
    border-radius: 8px;
    padding: 2rem;
  }

  .menu-btn {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    border: 2px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .menu-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .menu-btn.special {
    background: #fff;
    color: #242943;
  }

  .menu-btn.special:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Modal styles */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0);
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    visibility: hidden;
    transition: background 0.3s ease, visibility 0.3s ease;
  }

  .modal.active {
    visibility: visible;
    background: rgba(0, 0, 0, 0.85);
  }

  .modal-content {
    background: #242943;
    border-radius: 12px;
    max-width: 960px;
    max-height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    width: 100%;
    opacity: 0;
    transform: translateY(30px) scale(0.97);
    transition: opacity 0.35s ease, transform 0.35s ease;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  }

  .modal.active .modal-content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
  }

  .modal-close {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    line-height: 1;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
  }

  .modal-body {
    padding: 2rem;
    text-align: center;
    overflow-y: auto;
    flex: 1;
  }

  .modal-body img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .menu-buttons {
      flex-direction: column;
      gap: 1rem;
      min-height: 250px;
    }

    .menu-btn {
      width: 100%;
      max-width: 250px;
    }
  }
</style>

<script>
  function openModal(modal: HTMLElement) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function closeAllModals() {
    document.querySelectorAll('.modal.active').forEach(modal => {
      closeModal(modal as HTMLElement);
    });
  }

  document.querySelectorAll('.menu-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-modal');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (modal) openModal(modal);
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = btn.closest('.modal') as HTMLElement | null;
      if (modal) closeModal(modal);
    });
  });

  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal as HTMLElement);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllModals();
  });
</script>
