---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="交通指引"
  description="前往密式旅行露營區的詳細交通指引，包含大湖路線和豆腐街路線兩種選擇"
  keywords="密式旅行交通, 苗栗露營交通, 泰安露營區路線, 大湖路線, 豆腐街路線"
>
  <main id="main" class="alt">
    <section id="one">
      <div class="inner">
        <Breadcrumb items={[
          { label: '關於密式', href: '/infos/' },
          { label: '交通指引' }
        ]} />
        <header class="major">
          <h1>交通指引</h1>
        </header>

        <div class="guide-buttons">
          <button type="button" class="guide-btn special" data-modal="guide_1">經大湖市區</button>
          <button type="button" class="guide-btn" data-modal="guide_2">經豆腐街</button>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal: 大湖路線 -->
  <div class="modal" id="guide_1">
    <div class="modal-content">
      <div class="modal-header">
        <h2>大湖路線</h2>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_1.webp" alt="大湖路線步驟1" loading="lazy" /></div>
          <div class="step-text"><p>出七十二快速道路後往右轉經大湖上山(較建議路段)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_2.webp" alt="大湖路線步驟2" loading="lazy" /></div>
          <div class="step-text"><p>看到大湖國中右轉苗栗六十一號縣道 (細細邦道)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_3.webp" alt="大湖路線步驟3" loading="lazy" /></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_4.webp" alt="大湖路線步驟4" loading="lazy" /></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行，沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_5.webp" alt="大湖路線步驟5" loading="lazy" /></div>
          <div class="step-text"><p>沿途經過小小的大安橋</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_6.webp" alt="大湖路線步驟6" loading="lazy" /></div>
          <div class="step-text">
            <p>經過下圖路口時，請注意不要錯過，左轉上坡後路就變大條了!!</p>
            <p class="red">請勿直走，直走導航會帶您走超小的路線!!</p>
            <p>"左轉"有大量露營指示牌的山路</p>
          </div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_7.webp" alt="大湖路線步驟7" loading="lazy" /></div>
          <div class="step-text"><p>沿途經過此小岔路，右轉上坡 請繼續沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_8.webp" alt="大湖路線步驟8" loading="lazy" /></div>
          <div class="step-text"><p>上坡後經泰安國中小</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_9.webp" alt="大湖路線步驟9" loading="lazy" /></div>
          <div class="step-text"><p>看到大興派出所路口右轉</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_10.webp" alt="大湖路線步驟10" loading="lazy" /></div>
          <div class="step-text"><p>經過派出所後，皆一直直行，走最大條的路(平緩沒有上下坡)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_11.webp" alt="大湖路線步驟11" loading="lazy" /></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行，沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_1_12.webp" alt="大湖路線步驟12" loading="lazy" /></div>
          <div class="step-text">
            <p class="yellow">🌟 抵達密式入口 🌟</p>
            <p>觀山之屋區/四人套房(閲陽、近雲)皆在此入口旁圍牆前臨停，通知營主等候帶位</p>
            <p>依山之屋/雙人套房/營位直接從入口下坡駛入</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: 豆腐街路線 -->
  <div class="modal" id="guide_2">
    <div class="modal-content">
      <div class="modal-header">
        <h2>豆腐街路線</h2>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_1.webp" alt="豆腐街路線步驟1" loading="lazy" /></div>
          <div class="step-text"><p>出七十二快速道路後直行經清安苗62-1上山</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_2.webp" alt="豆腐街路線步驟2" loading="lazy" /></div>
          <div class="step-text"><p>72快速道路走到底汶水端</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_3.webp" alt="豆腐街路線步驟3" loading="lazy" /></div>
          <div class="step-text"><p>直行走往清安方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_4.webp" alt="豆腐街路線步驟4" loading="lazy" /></div>
          <div class="step-text"><p>左轉往清安方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_5.webp" alt="豆腐街路線步驟5" loading="lazy" /></div>
          <div class="step-text"><p>岔路往左經萊爾富至豆腐街</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_6.webp" alt="豆腐街路線步驟6" loading="lazy" /></div>
          <div class="step-text"><p>至溫泉區路口右轉走苗62-1</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_7.webp" alt="豆腐街路線步驟7" loading="lazy" /></div>
          <div class="step-text"><p>右轉親善橋</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_8.webp" alt="豆腐街路線步驟8" loading="lazy" /></div>
          <div class="step-text">
            <p>經過下圖路口時，請注意不要錯過，請右轉上坡!!</p>
            <p class="red">請勿直走，直走導航會帶您走超小的路線!!一定迷路</p>
            <p>於苗 62-1 1.5 公里處右轉上山</p>
          </div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_9.webp" alt="豆腐街路線步驟9" loading="lazy" /></div>
          <div class="step-text"><p>行至三岔路口直走往大興南灣方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_10.webp" alt="豆腐街路線步驟10" loading="lazy" /></div>
          <div class="step-text"><p>此路口右轉往大興方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_11.webp" alt="豆腐街路線步驟11" loading="lazy" /></div>
          <div class="step-text"><p>沿著柏油路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_12.webp" alt="豆腐街路線步驟12" loading="lazy" /></div>
          <div class="step-text"><p>直行經過大興派出所</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_13.webp" alt="豆腐街路線步驟13" loading="lazy" /></div>
          <div class="step-text"><p>沿著南清聯絡道路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_14.webp" alt="豆腐街路線步驟14" loading="lazy" /></div>
          <div class="step-text"><p>沿著柏油路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img src="/images/guide/guide_2_15.webp" alt="豆腐街路線步驟15" loading="lazy" /></div>
          <div class="step-text">
            <p class="yellow">🌟 抵達密式入口 🌟</p>
            <p>觀山之屋區/四人套房(閲陽、近雲)皆在此入口旁圍牆前臨停，通知營主等候帶位</p>
            <p>依山之屋/雙人套房/營位直接從入口下坡駛入</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  #main.alt {
    background: #242943;
    padding-top: 5rem;
  }

  #one {
    padding: 2rem 0 4rem;
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .major h1 {
    font-size: 2rem;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #fff;
    display: inline-block;
    padding-bottom: 0.5rem;
  }

  .guide-buttons {
    display: flex;
    justify-content: center;
    gap: 2rem;
    min-height: 400px;
    align-items: center;
  }

  .guide-btn {
    padding: 1rem 3rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    border: 2px solid #fff;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .guide-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .guide-btn.special {
    background: #fff;
    color: #242943;
  }

  .guide-btn.special:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Modal styles */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 10000;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    overflow-y: auto;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    background: #242943;
    border-radius: 8px;
    max-width: 960px;
    width: 100%;
    margin: 2rem auto;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    background: #242943;
    z-index: 10;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.75rem;
    letter-spacing: 0.1em;
  }

  .modal-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .modal-body {
    padding: 2rem;
  }

  .guide-step {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .guide-step:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .step-image {
    flex: 2;
  }

  .step-image img {
    width: 100%;
    border-radius: 4px;
  }

  .step-text {
    flex: 1;
  }

  .step-text p {
    margin-bottom: 0.5rem;
  }

  .step-text p:last-child {
    margin-bottom: 0;
  }

  .yellow {
    color: #ffd306;
    font-weight: 600;
  }

  .red {
    color: #ff6b6b;
  }

  @media (max-width: 768px) {
    .guide-buttons {
      flex-direction: column;
      gap: 1rem;
      min-height: 300px;
    }

    .guide-btn {
      width: 100%;
      max-width: 300px;
    }

    .guide-step {
      flex-direction: column;
    }

    .modal {
      padding: 1rem;
    }

    .modal-body {
      padding: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.guide-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-modal');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = btn.closest('.modal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });

  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });
</script>
