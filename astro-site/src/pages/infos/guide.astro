---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuestNavigation from '../../components/GuestNavigation.astro';
---

<BaseLayout
  title="交通指引｜大湖與豆腐街路線"
  description="前往苗栗泰安密式旅行的兩條圖文路線：經大湖市區或清安豆腐街上山。查看七十二快速道路出口後的轉彎、沿途岔路及抵達園區的照片指引。"
  keywords="密式旅行交通, 苗栗露營交通, 泰安露營區路線, 大湖路線, 豆腐街路線"
>
  <main id="main" class="guest-page">
    <div class="guest-wrap">
      <Breadcrumb items={[{label:'關於密式',href:'/infos/'},{label:'交通指引'}]} />
      <header class="guest-header"><h1>交通指引</h1></header>
      <div class="guest-layout">
        <aside class="guest-sidebar"><GuestNavigation /></aside>
        <div class="guide-buttons guest-choice-grid">
          <button type="button" class="guide-btn guest-choice" data-modal="guide_1" aria-label="經大湖市區" aria-describedby="guide_1-summary">
            <span class="guest-choice-index" aria-hidden="true">ROUTE 01</span>
            <span class="guest-choice-title">經大湖市區</span>
            <span class="guest-choice-detail" id="guide_1-summary">出七十二快速道路後往右轉經大湖上山(較建議路段)</span>
            <span class="guest-choice-arrow" aria-hidden="true">→</span>
          </button>
          <button type="button" class="guide-btn guest-choice" data-modal="guide_2" aria-label="經豆腐街" aria-describedby="guide_2-summary">
            <span class="guest-choice-index" aria-hidden="true">ROUTE 02</span>
            <span class="guest-choice-title">經豆腐街</span>
            <span class="guest-choice-detail" id="guide_2-summary">出七十二快速道路後直行經清安苗62-1上山</span>
            <span class="guest-choice-arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>

  <!-- Modal: 大湖路線 -->
  <div class="modal" id="guide_1" role="dialog" aria-modal="true" aria-labelledby="guide_1-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="guide_1-title">大湖路線</h2>
        <button type="button" class="modal-close" aria-label="關閉對話框">&times;</button>
      </div>
      <div class="modal-body">
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_1.webp" alt="大湖路線步驟1" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_1.webp" alt="大湖路線步驟1" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>出七十二快速道路後往右轉經大湖上山(較建議路段)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_2.webp" alt="大湖路線步驟2" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_2.webp" alt="大湖路線步驟2" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>看到大湖國中右轉苗栗六十一號縣道 (細細邦道)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_3.webp" alt="大湖路線步驟3" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_3.webp" alt="大湖路線步驟3" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_4.webp" alt="大湖路線步驟4" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_4.webp" alt="大湖路線步驟4" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行，沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_5.webp" alt="大湖路線步驟5" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_5.webp" alt="大湖路線步驟5" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿途經過小小的大安橋</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_6.webp" alt="大湖路線步驟6" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_6.webp" alt="大湖路線步驟6" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text">
            <p>經過下圖路口時，請注意不要錯過，左轉上坡後路就變大條了!!</p>
            <p class="red">請勿直走，直走導航會帶您走超小的路線!!</p>
            <p>"左轉"有大量露營指示牌的山路</p>
          </div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_7.webp" alt="大湖路線步驟7" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_7.webp" alt="大湖路線步驟7" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿途經過此小岔路，右轉上坡 請繼續沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_8.webp" alt="大湖路線步驟8" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_8.webp" alt="大湖路線步驟8" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>上坡後經泰安國中小</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_9.webp" alt="大湖路線步驟9" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_9.webp" alt="大湖路線步驟9" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>看到大興派出所路口右轉</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_10.webp" alt="大湖路線步驟10" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_10.webp" alt="大湖路線步驟10" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>經過派出所後，皆一直直行，走最大條的路(平緩沒有上下坡)</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_11.webp" alt="大湖路線步驟11" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_11.webp" alt="大湖路線步驟11" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿途經過此岔路請繼續直行，沿著主要幹道開</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_1_12.webp" alt="大湖路線步驟12" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_1_12.webp" alt="大湖路線步驟12" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text">
            <p class="yellow">🌟 抵達密式入口 🌟</p>
            <p>觀山之屋區/四人套房(閲陽、近雲)皆在此入口旁圍牆前臨停，通知營主等候帶位</p>
            <p>依山之屋/雙人套房/營位直接從入口下坡駛入</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: 豆腐街路線 -->
  <div class="modal" id="guide_2" role="dialog" aria-modal="true" aria-labelledby="guide_2-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="guide_2-title">豆腐街路線</h2>
        <button type="button" class="modal-close" aria-label="關閉對話框">&times;</button>
      </div>
      <div class="modal-body">
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_1.webp" alt="豆腐街路線步驟1" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_1.webp" alt="豆腐街路線步驟1" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>出七十二快速道路後直行經清安苗62-1上山</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_2.webp" alt="豆腐街路線步驟2" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_2.webp" alt="豆腐街路線步驟2" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>72快速道路走到底汶水端</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_3.webp" alt="豆腐街路線步驟3" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_3.webp" alt="豆腐街路線步驟3" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>直行走往清安方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_4.webp" alt="豆腐街路線步驟4" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_4.webp" alt="豆腐街路線步驟4" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>左轉往清安方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_5.webp" alt="豆腐街路線步驟5" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_5.webp" alt="豆腐街路線步驟5" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>岔路往左經萊爾富至豆腐街</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_6.webp" alt="豆腐街路線步驟6" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_6.webp" alt="豆腐街路線步驟6" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>至溫泉區路口右轉走苗62-1</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_7.webp" alt="豆腐街路線步驟7" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_7.webp" alt="豆腐街路線步驟7" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>右轉親善橋</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_8.webp" alt="豆腐街路線步驟8" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_8.webp" alt="豆腐街路線步驟8" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text">
            <p>經過下圖路口時，請注意不要錯過，請右轉上坡!!</p>
            <p class="red">請勿直走，直走導航會帶您走超小的路線!!一定迷路</p>
            <p>於苗 62-1 1.5 公里處右轉上山</p>
          </div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_9.webp" alt="豆腐街路線步驟9" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_9.webp" alt="豆腐街路線步驟9" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>行至三岔路口直走往大興南灣方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_10.webp" alt="豆腐街路線步驟10" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_10.webp" alt="豆腐街路線步驟10" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>此路口右轉往大興方向</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_11.webp" alt="豆腐街路線步驟11" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_11.webp" alt="豆腐街路線步驟11" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿著柏油路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_12.webp" alt="豆腐街路線步驟12" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_12.webp" alt="豆腐街路線步驟12" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>直行經過大興派出所</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_13.webp" alt="豆腐街路線步驟13" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_13.webp" alt="豆腐街路線步驟13" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿著南清聯絡道路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_14.webp" alt="豆腐街路線步驟14" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_14.webp" alt="豆腐街路線步驟14" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text"><p>沿著柏油路直行</p></div>
        </div>
        <div class="guide-step">
          <div class="step-image"><img data-src="/images/guide/guide_2_15.webp" alt="豆腐街路線步驟15" loading="lazy" decoding="async" width="600" height="400" /><noscript><img src="/images/guide/guide_2_15.webp" alt="豆腐街路線步驟15" loading="lazy" decoding="async" width="600" height="400" /></noscript></div>
          <div class="step-text">
            <p class="yellow">🌟 抵達密式入口 🌟</p>
            <p>觀山之屋區/四人套房(閲陽、近雲)皆在此入口旁圍牆前臨停，通知營主等候帶位</p>
            <p>依山之屋/雙人套房/營位直接從入口下坡駛入</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  </main>
</BaseLayout>



<script>
  function openModal(modal: HTMLElement) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function closeAllModals() {
    document.querySelectorAll('.modal.active').forEach(modal => {
      closeModal(modal as HTMLElement);
    });
  }

  document.querySelectorAll('.guide-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = btn.getAttribute('data-modal');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (modal) openModal(modal);
    });
  });

  document.querySelectorAll('.modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = btn.closest('.modal') as HTMLElement | null;
      if (modal) closeModal(modal);
    });
  });

  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal as HTMLElement);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllModals();
  });
</script>
