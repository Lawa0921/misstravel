---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../lib/config';

const rooms = await getCollection('rooms');
const sortedRooms = rooms.sort((a, b) => a.data.order - b.data.order);
const categories = [
  { id: 'campsite', label: '露營營位', icon: '🏕️' },
  { id: 'cabin', label: '露營木屋', icon: '🏡' },
  { id: 'suite', label: '套房', icon: '🛏️' },
] as const;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: sortedRooms.map((room, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: room.data.title,
    url: `${siteConfig.url}/rooms/${room.id.replace('.md', '')}/`,
    image: `${siteConfig.url}${room.data.mainImage}`,
  })),
};
---

<BaseLayout
  title="苗栗泰安房型｜露營營位、小木屋與套房"
  description="密式旅行提供多樣化住宿選擇：露營營位享受大自然、溫馨露營木屋適合家庭、舒適套房提供完整住宿空間。"
  keywords="密式旅行房型,露營營位,露營木屋,套房住宿,苗栗住宿價格"
  extraSchemas={[itemListSchema]}
>
  <main id="main" class="alt">
    <div class="inner">
      <Breadcrumb items={[{ label: '房型展示' }]} />
      <header class="major">
        <h1>房型展示</h1>
      </header>

      <nav class="category-nav" aria-label="住宿類型快速導覽">
        {categories.map((category) => {
          const count = sortedRooms.filter((room) => room.data.category === category.id).length;
          return (
            <a href={`#${category.id}`} class="category-link">
              <span class="category-icon" aria-hidden="true">{category.icon}</span>
              <span>{category.label}</span>
              <small>{count} 種選擇</small>
            </a>
          );
        })}
      </nav>

      {categories.map((category) => {
        const categoryRooms = sortedRooms.filter((room) => room.data.category === category.id);

        return (
          <section id={category.id} class="room-category" aria-labelledby={`${category.id}-title`}>
            <div class="category-heading">
              <span class="category-heading-icon" aria-hidden="true">{category.icon}</span>
              <div>
                <p>住宿類型</p>
                <h2 id={`${category.id}-title`}>{category.label}</h2>
              </div>
              <span class="category-count">{categoryRooms.length} 種選擇</span>
            </div>

            <div class="rooms-grid">
              {categoryRooms.map((room, roomIndex) => {
                const standardOption = room.data.priceOptions?.find((option) => option.isStandard);
                const alternativeOption = room.data.priceOptions?.find((option) => !option.isStandard);

                return (
                  <a
                    href={`/rooms/${room.id.replace('.md', '')}/`}
                    class="room-card"
                    data-motion-card=""
                    data-reveal=""
                    style={`--motion-order: ${roomIndex}`}
                  >
                    <h3>{room.data.title}</h3>
                    <div class="room-image">
                      <img
                        src={room.data.mainImage}
                        alt={`${room.data.shortTitle}房型照片`}
                        loading="lazy"
                        decoding="async"
                        width="600"
                        height="400"
                      />
                    </div>
                    <div class="room-prices">
                      {room.data.priceOptions && (
                        <p class="pricing-basis">四帳標準方案｜實際依帳數計價</p>
                      )}
                      {standardOption && (
                        <p class="standard-capacity">標準方案：最多 {standardOption.numberOfPeople} 人</p>
                      )}
                      <div class="price-row">
                        <span>👑 訂價：{room.data.standardPrice}</span>
                        <span>🥇 連假：{room.data.standardPrice}</span>
                      </div>
                      <div class="price-row">
                        <span>🥈 假日：{room.data.holidayPrice}</span>
                        <span>🥉 平日：{room.data.weekdayPrice}</span>
                      </div>
                      {alternativeOption && (
                        <p class="alternative-price">
                          三帳方案：平日 {alternativeOption.weekdayPrice}／假日 {alternativeOption.holidayPrice}／連假 {alternativeOption.standardPrice} 元
                        </p>
                      )}
                      {alternativeOption && (
                        <p class="alternative-capacity">三帳方案適用：{alternativeOption.numberOfPeople} 人以下</p>
                      )}
                      <div class="price-row">
                        <span>{room.data.category === 'campsite' ? '🏕️ 區域' : '🏠 房數'}：{room.data.numberOfRooms}</span>
                        <span>👥 人數：{room.data.numberOfPeople}</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  #main {
    background: var(--color-bg);
    padding: 6.5rem 0 5rem;
    color: var(--color-paper);
  }

  .inner {
    width: min(100% - 3rem, 72rem);
    margin: 0 auto;
  }

  header.major {
    max-width: 36rem;
    margin: 1.8rem 0 2.5rem;
  }

  header.major::after {
    display: block;
    width: 4.5rem;
    margin-top: 1rem;
    border-top: 2px solid var(--color-champagne);
    content: '';
  }

  header.major h1 {
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(2.25rem, 5vw, 4.6rem);
    line-height: 1.12;
    letter-spacing: 0.08em;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 5rem;
  }

  .category-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(232, 201, 130, 0.42);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-paper);
    box-shadow: 0 0.5rem 1.5rem rgba(9, 12, 28, 0.12);
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .category-link:hover,
  .category-link:focus-visible {
    border-color: var(--color-aqua);
    background: rgba(155, 241, 255, 0.14);
    color: var(--color-aqua);
    transform: translateY(-2px);
  }

  .category-icon {
    font-size: 1.15rem;
  }

  .category-link small {
    color: var(--color-paper-muted);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }

  .room-category {
    scroll-margin-top: 6rem;
    margin-bottom: 6rem;
  }

  .category-heading {
    display: flex;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(248, 244, 236, 0.2);
  }

  .category-heading-icon {
    color: var(--color-champagne);
    font-size: 2rem;
    line-height: 1;
  }

  .category-heading p {
    margin: 0 0 0.35rem;
    color: var(--color-paper-muted);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .category-heading h2 {
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    letter-spacing: 0.1em;
  }

  .category-count {
    margin-left: auto;
    color: var(--color-aqua);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .room-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    color: var(--color-paper);
    box-shadow: 0 1rem 2.5rem rgba(8, 10, 24, 0.22);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .room-card:hover,
  .room-card:focus-visible,
  .room-card:focus-within {
    border-color: var(--color-aqua);
    box-shadow: 0 1.25rem 3rem rgba(8, 10, 24, 0.32);
    color: var(--color-paper);
    transform: translateY(-4px);
  }

  .room-card h3 {
    order: 1;
    min-height: 4.2rem;
    margin: 0;
    padding: 1.2rem 1.25rem 0.8rem;
    color: var(--color-paper);
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: 0.08em;
  }

  .room-image {
    order: 2;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg);
  }

  .room-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .room-card:hover .room-image img,
  .room-card:focus-within .room-image img {
    transform: scale(1.035);
  }

  .room-prices {
    order: 3;
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.25rem 1.25rem;
    background: var(--color-surface);
  }

  .pricing-basis,
  .standard-capacity,
  .alternative-price,
  .alternative-capacity {
    margin: 0;
    line-height: 1.5;
  }

  .pricing-basis {
    color: var(--color-champagne);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .standard-capacity,
  .alternative-capacity {
    color: var(--color-paper-muted);
    font-size: 0.875rem;
  }

  .alternative-price {
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-aqua);
    font-size: 0.9rem;
  }

  .alternative-capacity {
    color: var(--color-aqua);
  }

  .price-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0;
  }

  .price-row span {
    min-width: 0;
    color: var(--color-paper);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    #main {
      padding-top: 5.5rem;
    }

    .inner {
      width: min(100% - 2rem, 42rem);
    }

    header.major {
      margin: 1.2rem 0 2rem;
    }

    .category-nav {
      margin-bottom: 3.5rem;
    }

    .room-category {
      margin-bottom: 4.5rem;
    }

    .category-heading {
      align-items: center;
    }

    .category-count {
      font-size: 0.75rem;
    }

    .rooms-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 390px) {
    .inner {
      width: min(100% - 1.5rem, 42rem);
    }

    .category-link {
      flex: 1 1 100%;
      justify-content: center;
    }

    .category-heading {
      align-items: flex-start;
    }

    .category-count {
      margin-top: 0.35rem;
    }

    .room-card h3,
    .room-prices {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .price-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-link,
    .room-card,
    .room-image img {
      transition: none;
    }
  }
</style>
