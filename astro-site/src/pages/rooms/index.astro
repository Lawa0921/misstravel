---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const rooms = await getCollection('rooms');
const sortedRooms = rooms.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="房型展示"
  description="密式旅行提供多樣化住宿選擇：露營車位享受大自然、溫馨小木屋適合家庭、舒適套房給您飯店般體驗。"
  keywords="密式旅行房型,露營車位,小木屋住宿,套房住宿,苗栗住宿價格"
>
  <section class="page-header">
    <div class="container">
      <h1>房型展示</h1>
      <p>密式旅行，位於群山的處所</p>
    </div>
  </section>

  <div id="main" class="alt">
    <div class="inner">
      <div class="rooms-grid">
        {sortedRooms.map((room) => (
          <a href={`/rooms/${room.id.replace('.md', '')}/`} class="room-card">
            <div class="room-image">
              <img
                src={room.data.mainImage}
                alt={`${room.data.shortTitle}住宿外觀`}
                loading="lazy"
              />
            </div>
            <div class="room-content">
              <h3>{room.data.title}</h3>
              <div class="room-prices">
                <div class="price-item">
                  <span class="label">👑 訂價</span>
                  <span class="value">${room.data.standardPrice}</span>
                </div>
                <div class="price-item">
                  <span class="label">🥇 連假</span>
                  <span class="value">${room.data.standardPrice}</span>
                </div>
                <div class="price-item">
                  <span class="label">🥈 假日</span>
                  <span class="value">${room.data.holidayPrice}</span>
                </div>
                <div class="price-item">
                  <span class="label">🥉 平日</span>
                  <span class="value">${room.data.weekdayPrice}</span>
                </div>
                <div class="price-item">
                  <span class="label">{room.data.isCampsite ? '🏕️ 區域' : '🏠 房數'}</span>
                  <span class="value">{room.data.numberOfRooms}</span>
                </div>
                <div class="price-item">
                  <span class="label">👥 人數</span>
                  <span class="value">{room.data.numberOfPeople}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 8rem 2rem 4rem;
    background: linear-gradient(135deg, #242943 0%, #2a2f4a 100%);
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .page-header p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
  }

  #main {
    background: #242943;
    padding: 3rem 0;
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .room-card {
    display: block;
    background: #2a2f4a;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-bottom: none;
  }

  .room-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .room-image {
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .room-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .room-card:hover .room-image img {
    transform: scale(1.05);
  }

  .room-content {
    padding: 1.5rem;
  }

  .room-content h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    text-align: center;
    letter-spacing: 0.1em;
  }

  .room-prices {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .price-item {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .price-item .label {
    color: rgba(255, 255, 255, 0.7);
  }

  .price-item .value {
    font-weight: 600;
    color: #9bf1ff;
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 6rem 1.5rem 3rem;
    }

    .page-header h1 {
      font-size: 2rem;
    }

    .rooms-grid {
      grid-template-columns: 1fr;
    }

    .room-image {
      height: 200px;
    }
  }
</style>
