---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../lib/config';
import { getRoomImageMetadata } from '../../lib/image-metadata';
import { createRoomSchemas } from '../../lib/room-schema';

export async function getStaticPaths() {
  const rooms = await getCollection('rooms');
  return rooms.map((room) => ({
    params: { slug: room.id.replace('.md', '') },
    props: { room },
  }));
}

const { room } = Astro.props;
const { Content } = await render(room);
const headingParts = room.data.title.match(/^(.*?)(\s*\([^)]*\))$/);

// Lead with the selected main photo; retain every original gallery image once.
const carouselImages = [...new Set([room.data.mainImage, ...room.data.images])];

const roomCategoryLabels = {
  campsite: '露營營位',
  cabin: '露營木屋',
  suite: '套房',
} as const;
const roomCategoryLabel = roomCategoryLabels[room.data.category];
const displayedPriceOptions = [...(room.data.priceOptions ?? [])]
  .sort((a, b) => a.weekdayPrice - b.weekdayPrice);
const startingWeekdayPrice = Math.min(room.data.weekdayPrice, ...displayedPriceOptions.map(option => option.weekdayPrice));

// Prefer the same accommodation category, then the closest capacity and weekday price.
const allRooms = await getCollection('rooms');
const relatedRooms = allRooms
  .filter((candidate) => candidate.id !== room.id)
  .sort((a, b) => {
    const categoryDifference = Number(a.data.category !== room.data.category)
      - Number(b.data.category !== room.data.category);
    if (categoryDifference !== 0) return categoryDifference;

    const capacityDifference = Math.abs(a.data.numberOfPeople - room.data.numberOfPeople)
      - Math.abs(b.data.numberOfPeople - room.data.numberOfPeople);
    if (capacityDifference !== 0) return capacityDifference;

    const priceDifference = Math.abs(a.data.weekdayPrice - room.data.weekdayPrice)
      - Math.abs(b.data.weekdayPrice - room.data.weekdayPrice);
    if (priceDifference !== 0) return priceDifference;

    return a.data.order - b.data.order;
  })
  .slice(0, 3);

---

<BaseLayout
  title={room.data.metaTitle}
  description={room.data.metaDescription}
  keywords={room.data.keywords}
  image={room.data.mainImage}
  preloadImage={carouselImages[0]}
  schemaType="LocalBusiness"
  extraSchemas={createRoomSchemas(room.id.replace(/\.md$/, ''), room.data)}
>
  <main id="main" class="alt">
    <div class="inner">
      <Breadcrumb items={[
        { label: '房型展示', href: '/rooms/' },
        { label: room.data.shortTitle }
      ]} />
      <header class="major">
        <h1>{headingParts ? <><span class="room-heading-name">{headingParts[1]}</span><span class="room-heading-plan">{headingParts[2]}</span></> : room.data.title}</h1>
      </header>
      <div class="room-summary" role="region" aria-label="房型摘要">
        <span class="summary-kicker">STAY / 密式旅行</span>
        <div class="summary-facts">
          <span class="summary-category">{roomCategoryLabel}</span>
          {displayedPriceOptions.length > 0 ? displayedPriceOptions.map((option) => (
            <span class={`summary-fact ${option.isStandard ? 'summary-standard' : 'summary-alternative'}`}>
              <strong>{option.label}・{option.numberOfPeople} 人以下</strong>
              <span>平日 NT${option.weekdayPrice.toLocaleString('zh-TW')} 起</span>
            </span>
          )) : (
            <>
              <span class="summary-fact"><strong>👥</strong> {room.data.numberOfPeople} 人</span>
              <span class="summary-fact">平日 NT${startingWeekdayPrice.toLocaleString('zh-TW')} 起</span>
            </>
          )}
        </div>
        <a
          href={siteConfig.booking.url}
          class="availability-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          查詢空房
        </a>
      </div>
    </div>

  <div id="main-content" class="room-detail">
    <div class="inner-content">
      <!-- Important Notice -->
        <section class="notice-panel" aria-label="預訂前提醒">
          <span class="notice-mark" aria-hidden="true">01</span>
          <div>
            <p class="eyebrow">Before you book</p>
            <h2 class="notice-title">『預訂前請先詳閱以下介紹(含延期退費說明)並衡量房間大小是否合適』</h2>
          </div>
        </section>

      <!-- Image Carousel -->
      <div class="carousel-container">
        <div class="carousel" id="room-carousel" tabindex="0" role="region" aria-roledescription="輪播" aria-label={`${room.data.shortTitle} 房型照片輪播`}>
          <div class="carousel-track">
            {carouselImages.map((image, index) => (
                <div
                  class={`carousel-slide ${index === 0 ? 'active' : ''}`}
                  data-index={index}
                  role="group"
                  aria-roledescription="投影片"
                  aria-label={`第 ${index + 1} 張，共 ${carouselImages.length} 張`}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                <img
                  src={index < 2 ? image : undefined}
                  data-src={index < 2 ? undefined : image}
                  alt={getRoomImageMetadata(image).alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : undefined}
                  width="900"
                  height="675"
                />
              </div>
            ))}
          </div>
          <button class="carousel-btn prev" type="button" aria-label="上一張">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="carousel-btn next" type="button" aria-label="下一張">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
          <div class="carousel-dots">
            {carouselImages.map((_, index) => (
              <button
                class={`dot ${index === 0 ? 'active' : ''}`}
                data-index={index}
                type="button"
                aria-label={`跳至圖片 ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>
        </div>
      </div>
      <noscript class="carousel-noscript">
        {carouselImages.slice(1).map((image) => (
          <img
            src={image}
            alt={getRoomImageMetadata(image).alt}
            loading="lazy"
            decoding="async"
            width="900"
            height="675"
          />
        ))}
      </noscript>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <a href={siteConfig.urls.account} class="btn-action">訂房流程</a>
        <a href={siteConfig.urls.roles} class="btn-action special">園內規約</a>
      </div>

      <!-- Booking Notice -->
      <div class="booking-notice">
        <h3>【訂位須知】</h3>
        <ul>
          <li>訂假日提早一晚夜衝者，當日價格一律半價(限晚上 6 點後至 10 點以前進場)</li>
          <li>營區及露營木屋無提供早晚餐，套房假日、連續假期附早餐（平日不附），無提供晚餐</li>
          <li>嚴禁直接在草皮或木板上烤肉及烹煮。若使用烤肉架、焚火台或快速爐等用具，請務必自備架高器具，並離地 60 公分以上</li>
          <li class="red">木屋區嚴禁攜帶寵物，如欲攜帶寵物請預訂露營營位</li>
          <li class="red">營位攜帶寵物如離開預訂區域請繫繩，如未繫繩將酌收 100 清潔費用/隻</li>
          <li>如攜帶訪客入場每人酌收 100 元清潔費，不可抵園區消費，需於晚上 8 點前離開園區，如超過則再加收每人 100 元共計 200 元的加人費。如未登記也未主動告知有訪客，事後被營主發現得勒令立即離場</li>
          <li>晚上 5 點後訪客禁止進入</li>
          <li>一帳限一車四人 (加人、加車費另計，加帳一律 800 元)</li>
          <li>為響應環保，園內住宿無提供盥洗用品，請自備毛巾及浴巾牙刷等盥洗用具</li>
        </ul>
      </div>

      <!-- Room Details -->
      <div class="room-content">
        <Content />
      </div>

      <!-- Day Type Definition -->
      <div class="day-definition">
        <h3>【平日、假日定義】</h3>
        <ul>
          <li>平日：星期日至星期四</li>
          <li>假日：星期五、星期六、國定假日</li>
          <li>連續假日包含年節期間及國定假日(含連休假期前一晚)</li>
        </ul>
      </div>

      <!-- Related Rooms -->
      <div class="related-section">
        <h3>其他住宿選擇</h3>
        <div class="related-grid">
          {relatedRooms.map((related) => (
            <a href={`/rooms/${related.id.replace('.md', '')}/`} class="related-card">
              <img
                src={related.data.mainImage}
                alt={getRoomImageMetadata(related.data.mainImage).alt}
                loading="lazy"
                decoding="async"
                width="400"
                height="150"
              />
              <div class="related-info">
                <h4>{related.data.shortTitle}</h4>
                <span class="related-price">{related.data.priceOptions ? `${related.data.priceOptions.find(option => option.isStandard)?.numberOfUnits} 帳平日` : '平日'} NT${related.data.weekdayPrice.toLocaleString('zh-TW')} 起</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
  </main>
</BaseLayout>

<style>
  #main.alt {
    background: var(--color-bg);
    color: var(--color-paper);
    padding: 6.5rem 0 0;
  }

  #main.alt > .inner {
    width: min(100% - 3rem, 62rem);
    margin: 0 auto;
    padding: 0 0 2rem;
  }

  .major {
    margin-top: 1.75rem;
  }

  .major h1 {
    max-width: 100%;
    text-wrap: balance;
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1.18;
    letter-spacing: 0.08em;
  }

  .room-heading-name { display: inline-block; max-width: 100%; }
  .room-heading-plan { display: inline-block; font-size: 0.68em; white-space: pre; letter-spacing: 0.04em; vertical-align: middle; }

  .room-summary {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(232, 201, 130, 0.42);
    border-radius: 0.9rem;
    background: var(--color-surface);
    box-shadow: 0 1rem 2.5rem rgba(8, 10, 24, 0.18);
  }

  .summary-kicker {
    grid-column: 1 / -1;
    color: var(--color-champagne);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
  }

  .summary-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1.25rem;
    color: rgba(248, 244, 236, 0.86);
    font-size: 0.9rem;
  }

  .summary-category {
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(155, 241, 255, 0.42);
    border-radius: 999px;
    color: var(--color-aqua);
    font-weight: 600;
  }

  .summary-fact strong {
    color: var(--color-champagne);
    font-weight: 600;
  }

  .summary-alternative {
    color: var(--color-aqua);
  }

  .summary-alternative strong {
    color: var(--color-aqua);
  }

  .availability-cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--color-aqua);
    border-radius: 999px;
    background: var(--color-aqua);
    color: var(--color-bg);
    font-weight: 700;
    letter-spacing: 0.1em;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .availability-cta:hover,
  .availability-cta:focus-visible {
    border-color: var(--color-paper);
    background: var(--color-paper);
    color: var(--color-bg);
  }

  #main-content {
    background: var(--color-bg);
    color: var(--color-paper);
    padding: 3.5rem 0 5rem;
  }

  .inner-content {
    width: min(100% - 3rem, 62rem);
    margin: 0 auto;
  }

  .notice-panel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    margin-bottom: 2.25rem;
    padding: 1.25rem 1.35rem;
    border-left: 3px solid var(--color-champagne);
    background: var(--color-surface);
  }

  .notice-mark {
    color: var(--color-champagne);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--color-champagne);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .notice-title {
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .carousel-container {
    margin-bottom: 2.5rem;
  }

  .carousel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-bg);
    box-shadow: 0 1.5rem 3.5rem rgba(36, 41, 67, 0.15);
    outline: none;
  }

  .carousel:focus-visible {
    box-shadow: 0 0 0 3px var(--color-aqua), 0 1.5rem 3.5rem rgba(36, 41, 67, 0.15);
  }

  .carousel-track {
    display: flex;
    transition: transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1);
    touch-action: pan-y;
  }

  .carousel-slide {
    min-width: 100%;
    aspect-ratio: 4 / 3;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .carousel-btn {
    position: absolute;
    top: calc((100% - 50px) / 2);
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(248, 244, 236, 0.7);
    border-radius: 50%;
    background: rgba(23, 27, 50, 0.7);
    color: var(--color-paper);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 180ms ease, color 180ms ease;
  }

  .carousel-btn:hover,
  .carousel-btn:focus-visible {
    background: var(--color-aqua);
    color: var(--color-bg);
  }

  .carousel-btn.prev { left: 1rem; }
  .carousel-btn.next { right: 1rem; }

  .carousel-dots {
    position: relative;
    width: 100%;
    display: flex;
    max-width: 100%;
    gap: 0;
    overflow-x: auto;
    padding: 0.15rem 0.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    scrollbar-width: thin;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }
  .dot::before {
    content: '';
    width: 10px;
    height: 10px;
    border: 1px solid var(--color-paper-muted);
    border-radius: 50%;
  }
  .dot.active::before,
  .dot[aria-current='true']::before {
    border-color: var(--color-champagne);
    background: var(--color-champagne);
  }
  .dot:focus-visible { outline-offset: -3px; }

  .carousel-noscript {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: -1.5rem 0 2.5rem;
  }

  .carousel-noscript img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .btn-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-aqua);
    border-radius: 999px;
    color: var(--color-aqua);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: background 180ms ease, color 180ms ease;
  }

  .btn-action:hover,
  .btn-action:focus-visible {
    background: var(--color-aqua);
    color: var(--color-bg);
  }

  .btn-action.special {
    border-color: var(--color-aqua);
    background: var(--color-aqua);
    color: var(--color-bg);
  }

  .btn-action.special:hover,
  .btn-action.special:focus-visible {
    border-color: var(--color-paper);
    background: var(--color-paper);
    color: var(--color-bg);
  }

  .booking-notice,
  .room-content,
  .day-definition,
  .related-section {
    margin-bottom: 3rem;
  }

  .booking-notice {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background: var(--color-surface);
  }

  .booking-notice h3,
  .day-definition h3,
  .related-section h3 {
    margin: 0 0 1.1rem;
    color: var(--color-paper);
    font-size: 1.15rem;
    letter-spacing: 0.1em;
  }

  .booking-notice ul,
  .day-definition ul,
  .room-content :global(ul) {
    margin: 0;
    padding-left: 1.35rem;
  }

  .booking-notice li,
  .day-definition li,
  .room-content :global(li) {
    margin-bottom: 0.65rem;
    color: var(--color-paper);
  }

  .booking-notice li:last-child,
  .day-definition li:last-child,
  .room-content :global(li:last-child) {
    margin-bottom: 0;
  }

  .booking-notice li.red {
    color: var(--color-danger);
  }

  .room-content :global(h4) {
    margin: 2rem 0 1rem;
    color: var(--color-champagne);
    font-size: 1.15rem;
  }

  .day-definition {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .related-section h3 {
    margin-bottom: 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-paper);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .related-card:hover,
  .related-card:focus-visible {
    border-color: var(--color-aqua);
    box-shadow: 0 0.75rem 1.5rem rgba(36, 41, 67, 0.12);
    color: var(--color-paper);
    transform: translateY(-3px);
  }

  .related-card img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
  }

  .related-info {
    padding: 0.9rem;
  }

  .related-info h4 {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .related-price {
    color: var(--color-aqua);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    #main.alt {
      padding-top: 5.5rem;
    }

    #main.alt > .inner,
    .inner-content {
      width: min(100% - 2rem, 42rem);
    }

    .room-summary {
      grid-template-columns: 1fr;
    }

    .availability-cta {
      width: 100%;
    }

    .carousel-btn.prev { left: 0.6rem; }
    .carousel-btn.next { right: 0.6rem; }



    .carousel-noscript,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 390px) {
    #main.alt > .inner,
    .inner-content {
      width: min(100% - 1.5rem, 42rem);
    }

    .notice-panel,
    .booking-notice {
      padding: 1rem;
    }

    .action-buttons {
      display: grid;
      grid-template-columns: 1fr;
    }

    .carousel-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track,
    .carousel-btn,
    .availability-cta,
    .btn-action,
    .related-card {
      transition: none;
    }
  }
</style>

<script>
  const carousel = document.getElementById('room-carousel');
  if (carousel) {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const slideImages = Array.from(carousel.querySelectorAll<HTMLImageElement>('.carousel-slide img'));
    const dots = carousel.querySelectorAll('.dot');
    const prevBtn = carousel.querySelector('.prev');
    const nextBtn = carousel.querySelector('.next');
    let currentIndex = 0;
    let navigationToken = 0;

    function normalizeIndex(index: number) {
      return (index + slides.length) % slides.length;
    }

    function prepareImage(index: number) {
      const image = slideImages[normalizeIndex(index)];
      const deferredSrc = image?.dataset.src;
      if (image && deferredSrc) {
        image.loading = 'eager';
        image.src = deferredSrc;
        delete image.dataset.src;
      }
      return image;
    }

    async function waitForImage(image?: HTMLImageElement) {
      if (!image || image.complete) return;
      try {
        await image.decode();
      } catch {
        await new Promise<void>((resolve) => {
          image.addEventListener('load', () => resolve(), { once: true });
          image.addEventListener('error', () => resolve(), { once: true });
        });
      }
    }

    function updateCarousel() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentIndex);
        slide.setAttribute('aria-hidden', i === currentIndex ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
        dot.setAttribute('aria-current', i === currentIndex ? 'true' : 'false');
      });
      // Reveal the active touch control without scrolling the page.
      const activeDot = dots[currentIndex] as HTMLElement;
      const strip = activeDot?.parentElement;
      if (strip && activeDot) {
        const left = activeDot.offsetLeft;
        if (left < strip.scrollLeft) strip.scrollLeft = left;
        else if (left + activeDot.offsetWidth > strip.scrollLeft + strip.clientWidth) {
          strip.scrollLeft = left + activeDot.offsetWidth - strip.clientWidth;
        }
      }

    }

    function preloadNeighbors() {
      prepareImage(currentIndex + 1);
      prepareImage(currentIndex - 1);
    }

    async function navigateTo(index: number) {
      const targetIndex = normalizeIndex(index);
      const token = ++navigationToken;
      const targetImage = prepareImage(targetIndex);
      await waitForImage(targetImage);
      if (token !== navigationToken) return;
      currentIndex = targetIndex;
      updateCarousel();
      preloadNeighbors();
    }

    prevBtn?.addEventListener('pointerenter', () => prepareImage(currentIndex - 1));
    prevBtn?.addEventListener('focus', () => prepareImage(currentIndex - 1));
    prevBtn?.addEventListener('click', () => void navigateTo(currentIndex - 1));

    nextBtn?.addEventListener('pointerenter', () => prepareImage(currentIndex + 1));
    nextBtn?.addEventListener('focus', () => prepareImage(currentIndex + 1));
    nextBtn?.addEventListener('click', () => void navigateTo(currentIndex + 1));

    dots.forEach((dot, i) => {
      dot.addEventListener('pointerenter', () => prepareImage(i));
      dot.addEventListener('focus', () => prepareImage(i));
      dot.addEventListener('click', () => void navigateTo(i));
    });

    // Keyboard navigation is owned by the shared accessibility enhancer.

    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      prepareImage(currentIndex + 1);
      prepareImage(currentIndex - 1);
    });

    track.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        void navigateTo(diff > 0 ? currentIndex + 1 : currentIndex - 1);
      }
    });

    updateCarousel();
    preloadNeighbors();
  }
</script>
