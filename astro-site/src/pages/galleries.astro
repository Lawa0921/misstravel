---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../lib/config';
import { galleryImages } from '../lib/gallery';

const imageGallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  '@id': `${siteConfig.url}/galleries/#imagegallery`,
  name: '密式旅行圖集',
  description: '密式旅行露營區原圖集，記錄園區旅途中所見的景色與日常。',
  url: `${siteConfig.url}/galleries/`,
  image: galleryImages.map((img) => ({
    '@type': 'ImageObject',
    contentUrl: `${siteConfig.url}${img.src}`,
    name: img.alt,
  })),
};
---

<BaseLayout
  title="密式旅行圖集"
  description="探索密式旅行露營區的美麗風景：雲海繚繞的清晨、絢麗夕陽、舒適住宿空間、兒童遊樂設施、桌遊咖啡廳等。"
  keywords="密式旅行照片,露營區實景,苗栗露營照片,泰安風景,雲海照片,夕陽美景"
  extraSchemas={[imageGallerySchema]}
>
  <main id="main" class="alt">
    <section id="one">
      <div class="inner">
        <Breadcrumb items={[{ label: '密式圖集' }]} />
        <header class="major">
          <p class="eyebrow">THE PHOTO JOURNAL</p>
          <h1>密式圖集</h1>
          <p class="intro">山林、日常與旅途中的小片段，在這裡慢慢看。</p>
        </header>

        <div class="lightbox-gallery">
          <div class="row photos">
            {galleryImages.map((image, index) => (
              <div
                class="item"
                data-motion-card=""
                data-reveal=""
                style={`--motion-order: ${index % 4}`}
              >
                <a href={image.src} data-lightbox="photos" data-alt={image.alt} aria-label={`開啟${image.alt}`}>
                  <img class="img-fluid" src={image.src} alt={image.alt} loading="lazy" decoding="async" width="945" height="709" />
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  <!-- Lightbox Overlay -->
  <div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="圖片瀏覽">
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" aria-label="關閉">&times;</button>
      <button type="button" class="lightbox-nav lightbox-prev" aria-label="上一張">&lt;</button>
      <img src="" alt={galleryImages[0].alt} id="lightbox-image" decoding="async" width="945" height="709" />
      <button type="button" class="lightbox-nav lightbox-next" aria-label="下一張">&gt;</button>
      <div class="lightbox-counter">
        <span id="lightbox-current">1</span> / <span id="lightbox-total">{galleryImages.length}</span>
      </div>
    </div>
  </div>
  </main>
</BaseLayout>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxCurrent = document.getElementById('lightbox-current');
  const lightboxTotal = document.getElementById('lightbox-total');
  const closeBtn = lightbox?.querySelector('.lightbox-close');
  const prevBtn = lightbox?.querySelector('.lightbox-prev');
  const nextBtn = lightbox?.querySelector('.lightbox-next');

  const galleryLinks = document.querySelectorAll('[data-lightbox="photos"]');
  const images = Array.from(galleryLinks).map((link) => ({
    src: (link as HTMLAnchorElement).href,
    alt: link.getAttribute('data-alt') || '密式旅行圖集照片',
  }));
  let currentIndex = 0;

  if (lightboxTotal) {
    lightboxTotal.textContent = String(images.length);
  }

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightbox();
    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  function updateLightbox() {
    if (lightboxImage) {
      lightboxImage.src = images[currentIndex].src;
      lightboxImage.alt = images[currentIndex].alt;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        lightboxImage.animate(
          [
            { opacity: 0.35, transform: 'scale(0.985)' },
            { opacity: 1, transform: 'scale(1)' },
          ],
          { duration: 260, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    }
    if (lightboxCurrent) {
      lightboxCurrent.textContent = String(currentIndex + 1);
    }
  }

  function showPrev() {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    updateLightbox();
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % images.length;
    updateLightbox();
  }

  // Event listeners
  galleryLinks.forEach((link, index) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openLightbox(index);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  // Close on overlay click
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;

    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPrev();
    if (e.key === 'ArrowRight') showNext();
  });
</script>

<style>
  #main.alt {
    background:
      radial-gradient(circle at 15% 0%, rgba(202, 170, 113, 0.12), transparent 28rem),
      linear-gradient(180deg, #242943 0%, #1b1f34 100%);
    padding: 5.5rem 0 6rem;
  }

  .inner {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .major {
    text-align: left;
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: #d7ba7d;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .major h1 {
    color: #fffaf0;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    letter-spacing: 0.12em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .intro {
    color: rgba(255, 250, 240, 0.72);
    font-size: 1.05rem;
    line-height: 1.9;
    margin: 0;
  }

  .lightbox-gallery {
    margin-top: 1rem;
  }

  .row.photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .item a {
    display: block;
    border-bottom: none;
    overflow: hidden;
    border: 1px solid rgba(255, 250, 240, 0.14);
    border-radius: 0.35rem;
    background: rgba(255, 250, 240, 0.05);
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .item img {
    aspect-ratio: 945 / 709;
    display: block;
    width: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .item a:hover,
  .item a:focus-visible {
    border-color: #d7ba7d;
    background: rgba(215, 186, 125, 0.12);
    transform: translateY(-0.2rem);
  }

  .item a:hover img,
  .item a:focus-visible img {
    transform: scale(1.04);
    opacity: 0.9;
  }

  .item a:focus-visible {
    outline: 3px solid #d7ba7d;
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .row.photos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .inner {
      padding: 0 2rem;
    }
  }

  @media (max-width: 640px) {
    #main.alt {
      padding-top: 4.5rem;
    }

    .inner {
      padding: 0 1.25rem;
    }

    .row.photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }
  }

  /* Lightbox Overlay */
  .lightbox-overlay {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 18, 31, 0.96);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    backdrop-filter: blur(0);
    transition:
      opacity 0.35s ease,
      backdrop-filter 0.35s ease,
      visibility 0s linear 0.35s;
  }

  .lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
    backdrop-filter: blur(12px);
    transition:
      opacity 0.35s ease,
      backdrop-filter 0.35s ease,
      visibility 0s linear;
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    opacity: 0;
    transform: translateY(18px) scale(0.96);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-overlay.active .lightbox-content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    display: block;
    border: 1px solid rgba(255, 250, 240, 0.18);
    border-radius: 3px;
  }

  .lightbox-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #fffaf0;
    font-size: 2rem;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    line-height: 1;
  }

  .lightbox-close:hover {
    color: #d7ba7d;
  }

  .lightbox-close:focus-visible,
  .lightbox-nav:focus-visible {
    outline: 3px solid #d7ba7d;
    outline-offset: 3px;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: #fffaf0;
    font-size: 2rem;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    padding: 0.75rem 1rem;
    transition: background 0.2s ease;
  }

  .lightbox-nav:hover {
    background: rgba(215, 186, 125, 0.24);
  }

  .lightbox-prev {
    left: -80px;
  }

  .lightbox-next {
    right: -80px;
  }

  .lightbox-counter {
    position: absolute;
    bottom: -35px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 250, 240, 0.78);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .lightbox-close {
      top: 0.5rem;
      right: 0.5rem;
      background: rgba(15, 18, 31, 0.72);
    }

    .lightbox-prev {
      left: 10px;
    }

    .lightbox-next {
      right: 10px;
    }

    .lightbox-nav {
      padding: 0.75rem 1rem;
      font-size: 1.5rem;
    }
  }
</style>
