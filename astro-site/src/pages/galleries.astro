---
import { responsiveImage, imageSizes } from '../lib/responsive-images';
import PhotoViewer from '../components/PhotoViewer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../lib/config';
import { galleryImages } from '../lib/gallery';

const imageGallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  '@id': `${siteConfig.url}/galleries/#imagegallery`,
  name: '密式旅行圖集',
  description: '密式旅行露營區原圖集，記錄園區旅途中所見的景色與日常。',
  url: `${siteConfig.url}/galleries/`,
  image: galleryImages.map((img) => ({
    '@type': 'ImageObject',
    contentUrl: `${siteConfig.url}${img.src}`,
    name: img.alt,
  })),
};
---

<BaseLayout
  title="密式旅行圖集"
  description="探索密式旅行露營區的美麗風景：雲海繚繞的清晨、絢麗夕陽、舒適住宿空間、兒童遊樂設施、桌遊咖啡廳等。"
  keywords="密式旅行照片,露營區實景,苗栗露營照片,泰安風景,雲海照片,夕陽美景"
  extraSchemas={[imageGallerySchema]}
>
  <main id="main" class="alt">
    <section id="one">
      <div class="inner">
        <Breadcrumb items={[{ label: '密式圖集' }]} />
        <header class="major">
          <p class="eyebrow">THE PHOTO JOURNAL</p>
          <h1>密式圖集</h1>
          <p class="intro">山林、日常與旅途中的小片段，在這裡慢慢看。</p>
        </header>

        <div class="lightbox-gallery">
          <div class="row photos">
            {galleryImages.map((image, index) => (
              <div
                class="item"
                data-motion-card=""
                data-reveal=""
                style={`--motion-order: ${index % 4}`}
              >
                <a href={image.src} data-lightbox="photos" data-alt={image.alt} aria-label={`開啟${image.alt}`}>
                  <img class="img-fluid" {...responsiveImage(image.src, imageSizes.gallery)} alt={image.alt} loading="lazy" decoding="async" />
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <PhotoViewer id="lightbox" label="圖片瀏覽" mode="gallery" images={galleryImages} />
  </main>
</BaseLayout>

<style>
  #main.alt {
    background:
      radial-gradient(circle at 15% 0%, rgba(202, 170, 113, 0.12), transparent 28rem),
      linear-gradient(180deg, #242943 0%, #1b1f34 100%);
    padding: 5.5rem 0 6rem;
  }

  .inner {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .major {
    text-align: left;
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: #d7ba7d;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .major h1 {
    color: #fffaf0;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    letter-spacing: 0.12em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .intro {
    color: rgba(255, 250, 240, 0.72);
    font-size: 1.05rem;
    line-height: 1.9;
    margin: 0;
  }

  .lightbox-gallery {
    margin-top: 1rem;
  }

  .row.photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .item a {
    display: block;
    border-bottom: none;
    overflow: hidden;
    border: 1px solid rgba(255, 250, 240, 0.14);
    border-radius: 0.35rem;
    background: rgba(255, 250, 240, 0.05);
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .item img {
    aspect-ratio: 945 / 709;
    display: block;
    width: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .item a:hover,
  .item a:focus-visible {
    border-color: #d7ba7d;
    background: rgba(215, 186, 125, 0.12);
    transform: translateY(-0.2rem);
  }

  .item a:hover img,
  .item a:focus-visible img {
    transform: scale(1.04);
    opacity: 0.9;
  }

  .item a:focus-visible {
    outline: 3px solid #d7ba7d;
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .row.photos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .inner {
      padding: 0 2rem;
    }
  }

  @media (max-width: 640px) {
    #main.alt {
      padding-top: 4.5rem;
    }

    .inner {
      padding: 0 1.25rem;
    }

    .row.photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }
  }

</style>
