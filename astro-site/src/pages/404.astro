---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guest-pages.css';
---

<BaseLayout title="頁面不存在" noindex>
  <main id="main" class="error-page">
    <div class="container">
      <h1>404</h1>
      <h2>頁面不存在</h2>
      <p>抱歉，您要找的頁面不存在或已被移除。</p>
      <div class="error-actions"><a href="/" class="btn">返回首頁</a><a href="/rooms/" class="media-action">房型展示</a><a href="/infos/" class="media-action">關於密式</a></div>
    </div>
  </main>
</BaseLayout>

<style>

#main.error-page { display:grid; place-items:center; padding:8rem 1.5rem 4rem; min-height:72vh; text-align:center; background:var(--color-bg); }
.error-page .container { width:min(100%,52rem); padding:clamp(2rem,6vw,4rem); border:1px solid var(--color-border); border-radius:1rem; background:var(--color-surface); }
h1 { font-size:clamp(4rem,12vw,7rem); color:var(--color-aqua); letter-spacing:.15em; margin:0 0 1rem; }
h2 { font-size:1.6rem; } p { color:var(--color-paper-muted); line-height:1.9; }
.error-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:.75rem; margin-top:2rem; }
.error-actions a { margin:0; border-radius:99px; font-size:.95rem; padding:.75rem 1.25rem; }
.error-actions .btn { background:var(--color-aqua); color:var(--color-bg); min-height:44px; }
</style>
