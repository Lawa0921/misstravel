---
import Head from '../components/SEO/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import interactionAccessibilityUrl from '../scripts/interaction-accessibility.js?url&no-inline';
import motionEffectsUrl from '../scripts/motion-effects.js?url&no-inline';
import '../styles/global.css';
import '../styles/technical-hardening.css';
import '../styles/motion-effects.css';

interface ArticleMeta {
  publishedTime: string;
  author: string;
  tags: string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  headerVariant?: 'default' | 'alt' | 'alt-style2';
  schemaType?: 'Organization' | 'LocalBusiness' | 'Accommodation' | 'BlogPosting';
  schemaData?: Record<string, unknown>;
  extraSchemas?: Record<string, unknown>[];
  preloadImage?: string;
  articleMeta?: ArticleMeta;
}

const {
  title,
  description,
  image,
  keywords,
  type,
  noindex,
  headerVariant = 'default',
  schemaType = 'Organization',
  schemaData,
  extraSchemas,
  preloadImage,
  articleMeta,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
  <Head
    title={title}
    description={description}
    image={image}
    keywords={keywords}
    type={type}
    noindex={noindex}
    schemaType={schemaType}
    schemaData={schemaData}
    extraSchemas={extraSchemas}
    preloadImage={preloadImage}
    articleMeta={articleMeta}
  />
  <body>
    <a href="#main" class="skip-link">跳至主要內容</a>
    <div id="wrapper">
      <Header variant={headerVariant} />

      <slot />

      <Footer />
    </div>
    <script is:inline src={interactionAccessibilityUrl} defer></script>
    <script is:inline src={motionEffectsUrl} defer></script>
  </body>
</html>
